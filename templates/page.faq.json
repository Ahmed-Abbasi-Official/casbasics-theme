    "returns": {
      "type": "cb-accordions",
      "blocks": {
        "returns_1": {
          "type": "item",
          "settings": {
            "question": "What if the abaya doesn’t fit or I need alterations?",
            "answer": "<p>CAS abayas are stitched exactly according to the measurements provided by the customer. To ensure the best fit, we strongly recommend reviewing our size chart and double-checking measurements before placing your order.</p><p>If the abaya is <strong>too loose or long</strong>, we offer a professional alteration service for <strong>AED 50</strong>, which includes pickup and delivery.</p><p>If the abaya is <strong>too tight or short</strong>, fabric cannot be extended, and a brand-new replacement abaya must be stitched. This service is available for <strong>AED 150</strong>, including delivery.</p><p>If you wish to change the fabric after receiving your abaya, we can create a new replacement piece for <strong>AED 150</strong>, as fabrics are sourced specifically for each customized order.</p>"
          }
        },
        "returns_2": {
          "type": "item",
          "settings": {
            "question": "Can I make changes right after placing my order?",
            "answer": "<p>Yes. Customers may request order changes through Email or WhatsApp <strong>within 24 hours of placing the order</strong> without any additional charges.</p><p>After 24 hours, production begins and changes may not be possible. Any sizing or fabric changes requested after production has started will be treated as alteration or replacement requests and applicable service fees will apply.</p><p>To avoid additional charges, we recommend carefully reviewing your measurements, design details, and customization requests before confirming your order.</p>"
          }
        },
        "returns_3": {
          "type": "item",
          "settings": {
            "question": "Can I exchange a Ready-to-Wear abaya?",
            "answer": "<p>No. Ready-to-Wear abayas are sold strictly as final sale items and are <strong>not eligible for customization, alterations, refunds, or exchanges under any circumstances</strong>.</p><p>RTW abayas are dispatched exactly as displayed and cannot be modified after purchase.</p>"
          }
        },
        "returns_4": {
          "type": "item",
          "settings": {
            "question": "Can I cancel my order?",
            "answer": "<p>An order can only be cancelled within 48 hours of placing it. Please provide your order number so we can assist you with the cancellation process.</p>"
          }
        }
      },
      "block_order": [
