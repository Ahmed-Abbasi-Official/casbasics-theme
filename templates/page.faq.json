    "shipping": {
      "type": "cb-accordions",
      "blocks": {
        "shipping_1": {
          "type": "item",
          "settings": {
            "question": "How long does it take to get my abaya?",
            "answer": "<p>Here’s what you can expect regarding shipping:</p><ul><li><strong>Production Time</strong>: Your customized abaya will be made within <strong>10-12 business days</strong>.</li><li><strong>Domestic Shipping (within UAE)</strong>: Once your abaya is ready, domestic shipping can take up to <strong>2-5 business days</strong>.</li><li><strong>International Shipping</strong>: Shipping times for international orders will vary depending on your location.</li></ul><p></p><p>If 14 business days have passed and you haven't received your order yet please send us a WhatsApp or drop us an email at <strong>info@casbasics.com</strong> with your Full Name, Order Number and Contact Number.</p><p>&nbsp;</p>"
          }
        },
        "shipping_2": {
          "type": "item",
          "settings": {
            "question": "How much does it cost?",
            "answer": "<p>Standard&nbsp;rate of&nbsp;<strong>AED 19&nbsp;</strong>for all cities across UAE (Abu Dhabi, Ajman, Dubai, Sharjah, UAQ, Ras Al Khaimah, Fujairah).&nbsp;</p><p>For international deliveries, shipping costs are calculated during checkout based on weight, dimensions and&nbsp;destination of the items in the order.</p>"
          }
        },
        "shipping_3": {
          "type": "item",
          "settings": {
            "question": "Is there free shipping?",
            "answer": "<p>Yes! We provide free shipping on domestic orders over <strong>AED 999</strong>. Be sure to check your cart for details on our current free shipping offer!</p>"
          }
        },
        "shipping_4": {
          "type": "item",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes, we ship our products worldwide!&nbsp;</p><p><strong>Please note that free shipping does not apply to international orders</strong>, and shipping rates may vary depending on your region.&nbsp;</p><p>We use <strong>DHL </strong>for reliable and efficient international shipping.&nbsp;</p>"
          }
        },
        "shipping_5": {
          "type": "item",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p><strong>How much is shipping?</strong></p><p><strong>UAE:</strong> AED 19. Orders of AED 1,000+ Free delivery</p><p><strong>Saudi Arabia, Kuwait, Bahrain, Oman:</strong> AED 40. Orders of AED 1,200+ &nbsp;Free delivery</p><p><strong>Qatar:</strong> From AED 80</p><p><strong>UK:</strong> From AED 100</p><p><strong>Jordan:</strong> From AED 100</p><p><strong>USA, Canada, Australia:</strong> From AED 150</p><p><strong>Lebanon, Egypt, Iraq:</strong> From AED 150</p><p><strong>Rest of the world:</strong> From AED 160</p><p></p><p>International rates vary with order size. Your exact shipping cost is shown at checkout before you pay.</p>"
          }
        },
        "shipping_6": {
          "type": "item",
          "settings": {
            "question": "How can I track my order?",
            "answer": "<p>To see your order status, please email your order details to info@casbasics.com or provide these details into WhatsApp Chat icon on bottom left.</p>"
          }
        },
        "shipping_7": {
          "type": "item",
          "settings": {
            "question": "Do you have physical stores or in-home shopping?",
            "answer": "<p><br/>Yes – our main branch is in Abu Dhabi, Dubai with outlets in Ajman and Ras Al Khaimah. We also offer a <strong>free home service</strong>: we bring 80–100 abayas to your home on a scheduled date. (To <a href=\"/pages/home-service-abaya\" title=\"CAS Abaya Home Service\">book a home visit</a>, a minimum purchase of 5 pieces is required – there is no booking or delivery fee.)<br/><br/></p>"
          }
        }
      },
