    "events": {
      "type": "cb-accordions",
      "blocks": {
        "events_1": {
          "type": "item",
          "settings": {
            "question": "Do you have special Eid or Ramadan collections, and when should I order?",
            "answer": "<p>Yes, we typically launch festive collections for <a href=\"/collections/ramadan-eid-abaya-2026\" title=\"Ramadan | Eid Abaya 2026\">Eid and Ramadan</a> with special designs and handwork. These pieces are custom-made, so plan ahead: production is usually <strong>10–12 days</strong>, and during Ramadan/Eid periods it can take <strong>12–15 days</strong>. We recommend ordering well before the holiday to ensure timely delivery. (Also note: if you need exchanges for intricate Eid abayas, additional fees may apply due to handwork.)<br/></p>"
          }
        },
        "events_2": {
          "type": "item",
          "settings": {
            "question": "What abayas do you recommend for weddings or parties?",
            "answer": "<p>For weddings and formal parties, we suggest our <a href=\"/collections/satin-abaya\" title=\"Satin Abaya\"><strong>Bridal Satin</strong></a> abayas (heavy weight with an elegant shine) or those in <a href=\"/collections/dantel-abaya\" title=\"Dantel Abaya\"><strong>Dantel,</strong></a><strong> </strong><a href=\"/collections/lace-abaya\" title=\"Lace Abaya\"><strong>lace</strong></a> (intricate and luxurious). These fabrics and cuts create a refined, festive look. You can customize length and embellishments as needed.</p>"
          }
        },
        "events_3": {
          "type": "item",
          "settings": {
            "question": "What about travel or vacation outfits?",
            "answer": "<p>We offer<a href=\"/collections/travel-wear\" title=\"Travel Wear\"> <strong>travel sets</strong></a> (coordinated abaya + sheila or matching separates) made for comfort on the go. For example, light cotton or linen blends are great for travel. (Please note: due to hygiene, travel wear and inner sets cannot be exchanged.)</p>"
          }
        },
        "events_4": {
          "type": "item",
          "settings": {
            "question": "Do you offer Abayas for Hajj & Umrah?",
            "answer": "<p>Yes, find our exclusive collection for <a href=\"/collections/hajj-and-umrah-abayas\" title=\"Hajj and Umrah Abayas\">Hajj & Umrah</a></p>"
          }
        }
      },
