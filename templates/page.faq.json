    "care": {
      "type": "cb-accordions",
      "blocks": {
        "care_1": {
          "type": "item",
          "settings": {
            "question": "How should I wash or clean my abaya?",
            "answer": "<p>Because CAS abayas uses delicate fabrics (nada, crepe, chiffon) and embellishments, we <strong>strongly recommend professional dry cleaning</strong>. Dry cleaning is the safest way to preserve the fabric and embroidery.<br/></p>"
          }
        },
        "care_2": {
          "type": "item",
          "settings": {
            "question": "How do I make my abaya last longer?",
            "answer": "<p>Follow the care instructions to keep your abaya beautiful. After wearing, hang it up to air out. Store it in a cover away from direct sunlight. Always clean stains promptly with professional help. Following these steps and avoiding harsh treatment will help your abaya “stay stunning for years”.<br/></p>"
          }
        },
        "care_3": {
          "type": "item",
          "settings": {
            "question": "Can I machine wash or tumble dry my abaya?",
            "answer": "<p>No – please avoid machine washing, tumble drying, bleach or harsh detergents. These can shrink or fade delicate materials and damage any beads, embroidery or stones. It’s best to handle abayas gently (hang or steam out wrinkles).</p>"
          }
        }
      },
