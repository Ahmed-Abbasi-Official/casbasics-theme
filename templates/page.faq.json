    "payments": {
      "type": "cb-accordions",
      "blocks": {
        "payments_1": {
          "type": "item",
          "settings": {
            "question": "What payment methods does CAS accept?",
            "answer": "<p>CAS Abaya offers multiple secure payment options:</p><p>• Online Card Payment<br/>• Cash on Delivery (COD) - for UAE Customers only<br/>• Bank Transfer<br/>• Apple Pay<br/>• Tabby (Installment payments — website checkout only)</p>"
          }
        },
        "payments_2": {
          "type": "item",
          "settings": {
            "question": "Can I pay Cash on Delivery?",
            "answer": "<p>Yes, COD is available with certain conditions.<br/>✔ Option available for UAE customers only<br/>✔ Returning customers can use COD for any order amount<br/>✔ First-time customers ordering AED 900 or above must pay at least 50% in advance</p><p>This helps us secure customized orders prepared specifically for you.</p>"
          }
        },
        "payments_3": {
          "type": "item",
          "settings": {
            "question": "Why do first-time customers need to pay in advance for orders above AED 900?",
            "answer": "<p>CAS Abaya customizes most abayas individually. Once an order is confirmed, fabric is sourced and stitching begins specifically for the customer. Advance payment helps cover production costs for bespoke pieces.<br/></p>"
          }
        },
        "payments_4": {
          "type": "item",
          "settings": {
            "question": "Can I pay in installments?",
            "answer": "<p>Yes. CAS offers <strong>Tabby installment payments</strong>, allowing you to split payments into smaller amounts without any interest rate.</p><p>📌 Tabby is available only when checking out directly through the website.</p>"
          }
        },
        "payments_5": {
          "type": "item",
          "settings": {
            "question": "Do you accept online payments?",
            "answer": "<p>Yes, we accept online payments through Stripe, PayPal, Apple Pay, Visa, MasterCard, and American Express.&nbsp;</p>"
          }
        },
        "payments_6": {
          "type": "item",
          "settings": {
            "question": "Is my payment data safe with you?",
            "answer": "<p>Yes. Your payment security is extremely important to us. CAS Abaya does <strong>not store or have access to your card details</strong>. All payments are processed through secure, trusted payment gateways that comply with <strong>PCI-DSS security standards</strong>, managed by the PCI Security Standards Council (including Visa, MasterCard, American Express, and Discover). This ensures your payment information is encrypted and protected at all times.<br/><br/></p>"
          }
        },
        "payments_7": {
          "type": "item",
          "settings": {
            "question": "Can I pay through bank transfer?",
            "answer": "<p>Yes. Customers can pay through bank transfer and share payment proof to confirm their order.</p><p>Your order will be processed once payment is verified.</p>"
          }
        },
        "payments_8": {
          "type": "item",
          "settings": {
            "question": "How do I confirm my payment?",
            "answer": "<p>After completing online payment or bank transfer:</p><p>✔ Share payment screenshot or receipt on our email (info@casbasics.com or Whatsapp ( +971585959872)&nbsp;<br/><br/>✔ Your order will be confirmed after verification<br/><br/>✔ You will receive an order confirmation message</p>"
          }
        },
        "payments_9": {
          "type": "item",
          "settings": {
            "question": "Is full payment required before delivery?",
            "answer": "<p>It depends on the order type:</p><p>• COD orders — Pay at delivery (eligible customers only)<br/><br/>• Customized orders above AED 900 (first-time customers) — Partial or full advance payment required<br/><br/>• Online / Tabby / Apple Pay — Payment completed at checkout</p>"
          }
        },
        "payments_10": {
          "type": "item",
          "settings": {
            "question": "Will I receive payment confirmation?",
            "answer": "<p>Yes. Once your payment is verified, CAS will send you an official order confirmation via WhatsApp or email.</p>"
          }
        },
        "payments_11": {
          "type": "item",
          "settings": {
            "question": "What happens if payment proof is not shared?",
            "answer": "<p>Orders requiring advance payment will <strong>not be processed</strong> until payment proof is received and verified.</p>"
          }
        }
      },
