        "text_faq": {
          "type": "text",
          "settings": {
            "text": "<p>CAS Abaya offers a wide range of high-quality abayas and travel wear, specializing in customized abayas that allow customers to personalize their sizes and design details. This FAQ section answers common questions about sizing, customization, delivery, payments, exchanges, and abaya care to help you shop with confidence. If you need further assistance, our team is always available via WhatsApp, social media, email, or live chat.</p>"
          }
        }
      },
