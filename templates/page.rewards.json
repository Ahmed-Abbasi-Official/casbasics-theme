    "faq": {
      "type": "cb-loyalty-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What is our Rewards Program?",
            "answer": "<p>Our Rewards Program is an exclusive loyalty system designed to enhance your shopping experience. Earn points through purchases and special activities, then redeem them for discounts, exclusive products, and VIP benefits. It's our way of saying thank you for your continued support.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "How do I become a member?",
            "answer": "<p>Membership is automatic and completely free! Simply create an account or place your first order, and you'll instantly become part of our rewards community. No additional sign-up steps required.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How can I track my rewards and tier status?",
            "answer": "<p>Your rewards dashboard provides a complete overview of your points balance, tier status, and available benefits. Visit the \"Rewards\" section to view your points history, redeem rewards, or check your progress towards the next tier level.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "How do I advance to higher VIP tiers?",
            "answer": "<p>Advancing through our VIP tiers is simple: earn points through purchases and program activities. Each tier has specific point requirements, and your progress is clearly displayed in your rewards dashboard. The more you engage with our program, the faster you'll unlock premium benefits.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Do my reward points expire?",
            "answer": "<p>Your reward points are yours to keep indefinitely. There's no expiration date, giving you complete flexibility to save and redeem your points whenever you choose. We believe in rewarding your loyalty on your terms.</p>"
          }
        }
      },
