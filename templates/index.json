        "text_000y": {
          "type": "text",
          "settings": {
            "text": "<p>At <strong>CAS Abaya</strong>, you can shop high-quality <strong>designer abayas online</strong> with <strong>worldwide delivery</strong>. Our abayas are crafted with premium fabrics like Turkish Cupro and Crepe, offering elegant designs that blend modern style with modest fashion.</p><p>You can explore and order your favorite abaya directly from our online store — <a href=\"/\"><strong>CASBasics.com</strong></a> — and enjoy secure international shipping.</p><p>Whether you’re shopping online or visiting in person, CAS Basics ensures a luxury abaya experience — trusted by modest fashion lovers around the world.</p>",
            "size": "normal"
          }
        }
