    "faq": {
      "type": "cb-accordions",
      "blocks": {
        "item_faq_1": {
          "type": "item",
          "settings": {
            "question": "How can I track my order?",
            "answer": "<p>To see your order status, please email your order details to info@casbasics.com or provide these details into Quick Chat icon on bottom left.</p>"
          }
        },
        "item_faq_3": {
          "type": "item",
          "settings": {
            "question": "Can I receive a ready-to-wear abaya within 1-2 days?",
            "answer": "<p>Yes, ready-to-wear abayas are processed within 1-2 days. Please note ready-to-wear products are under the READY TO WEAR (RTW) tab on the website and are labelled with \"C-RTW\" in their product names.</p>"
          }
        },
        "item_faq_5": {
          "type": "item",
          "settings": {
            "question": "How long will it take to deliver my order?",
            "answer": "<p>Custom orders require 10–12 BUSINESS days (Saturdays and Sundays are not included in duration).<br/><br/>If 12 business days have passed and you haven't received your order yet please send us a WhatsApp or drop us an email at info@casbasics.com with your Full Name and Contact Number.<br/><br/>Our team members will reach out within 24 hours.</p>"
          }
        },
        "item_faq_7": {
          "type": "item",
          "settings": {
            "question": "What is the price of an abaya in UAE?",
            "answer": "<p>Abaya prices in the UAE vary depending on fabric, design, and customization. At CAS Abaya, prices reflect premium fabrics, tailored sizing, and handcrafted details. We offer both customized and ready-to-wear options to suit different preferences and budgets.</p>"
          }
        },
        "item_faq_9": {
          "type": "item",
          "settings": {
            "question": "Do you have lace abayas?",
            "answer": "<p>Yes. CAS offers <a href=\"/collections/lace-abaya\" title=\"Lace Abaya\">lace abayas</a> featuring intricate dantel and embroidered lace detailing, perfect for formal events, Eid, and special occasions. Lace styles can also be customized in size and length.</p>"
          }
        },
        "item_faq_11": {
          "type": "item",
          "settings": {
            "question": "Do you sell black abaya work abayas?",
            "answer": "<p>Yes. <a href=\"/collections/black-abaya\" title=\"Black Abaya\">Black abayas</a> are one of our most popular styles. We offer black work abayas featuring embroidery, handwork, lace details, and elegant finishes suitable for daily wear, formal gatherings, and festive occasions. Check our <a href=\"/collections/work-abayas-professional-office-wear\" title=\"Work Abayas – Professional & Office Wear Styles\">dedicated work Abaya Collection</a></p>"
          }
        },
        "item_faq_2": {
          "type": "item",
          "settings": {
            "question": "Can I make adjustments to an abaya?",
            "answer": "<p>Yes, it is possible to make adjustments to an abaya. Please contact our team through <a href=\"https://api.whatsapp.com/send/?phone=971585959872&text&type=phone_number&app_absent=0\" target=\"_blank\" title=\"https://api.whatsapp.com/send/?phone=971585959872&text&type=phone_number&app_absent=0\">WhatsApp</a> to discuss the details and place your order.</p>"
          }
        },
        "item_faq_4": {
          "type": "item",
          "settings": {
            "question": "What is CAS Exchange or Refund Policy?",
            "answer": "<p>Our Exchange Policy lasts 7 days (Terms and Conditions apply). After 7 days we cannot offer you an exchange.<br/>To be eligible for an exchange, your item must be unused and in the same condition you received it. For more info please go through our <a href=\"https://casbasics.com/pages/exchange-refund-policy\" target=\"_blank\" title=\"Exchange Policy\">exchange policy here.</a></p>"
          }
        },
        "item_faq_6": {
          "type": "item",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes, we ship our products worldwide!</p><p><strong>Please note that free shipping does not apply to international orders</strong>, and shipping rates may vary depending on your region.</p><p>We use <strong>DHL </strong>for reliable and efficient international shipping.</p>"
          }
        },
        "item_faq_8": {
          "type": "item",
          "settings": {
            "question": "Do you sell authentic Emirati abayas?",
            "answer": "<p>Yes. CAS Abaya is a Dubai-based brand offering elegant Emirati abayas that blend tradition with modern tailoring. Our designs reflect classic modest silhouettes with refined fabrics and contemporary detailing.</p>"
          }
        },
        "item_faq_10": {
          "type": "item",
          "settings": {
            "question": "What is the best abaya for Umrah?",
            "answer": "<p>For Umrah, we recommend lightweight, breathable fabrics such as <a href=\"/collections/nada\" title=\"Nada Abaya\">Nada</a> or Crepe in simple, modest designs. Black abayas with minimal embellishment are popular for comfort and practicality during travel and worship. Check our dedicated <a href=\"/collections/hajj-and-umrah-abayas\" title=\"Hajj and Umrah Abayas\">Umrah Abaya Collection</a></p>"
          }
        }
      },
