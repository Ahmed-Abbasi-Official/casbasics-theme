        "item_faq_2": {
          "type": "item",
          "settings": {
            "question": "Can I make adjustments to an abaya?",
            "answer": "<p>Yes. Custom orders can be made in your preferred size and design at no extra cost — sizes XXS to 6XL and lengths from 49 to 62 inches, with pockets, side zippers and breastfeeding buttons added free of charge.</p>"
          }
        },
        "item_faq_3": {
          "type": "item",
          "settings": {
            "question": "Can I receive a ready-to-wear abaya within 1-2 days?",
            "answer": "<p>Yes. Ready-to-wear abayas are delivered within 1-2 business days.</p>"
          }
        },
        "item_faq_4": {
          "type": "item",
          "settings": {
            "question": "What is CAS Exchange or Refund Policy?",
            "answer": "<p>We don't offer any refunds or returns. Please see the <a href=\"/policies/refund-policy\">refund policy</a> for exchanges.</p>"
          }
        },
        "item_faq_5": {
          "type": "item",
          "settings": {
            "question": "How long will it take to deliver my order?",
            "answer": "<p>Custom orders are delivered within 10-12 days. Ready-to-wear abayas arrive within 1-2 business days.</p>"
          }
        },
        "item_faq_6": {
          "type": "item",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes, we ship worldwide. Shipping costs are calculated at checkout.</p>"
          }
        },
        "item_faq_7": {
          "type": "item",
          "settings": {
            "question": "What is the price of an abaya in UAE?",
            "answer": "<p>Our abayas start at AED 250 and go up to AED 800.</p>"
