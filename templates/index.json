    "icons_why": {
      "type": "cb-icons-row",
      "blocks": {
        "item_why_1": {
          "type": "item",
          "settings": {
            "icon": "prices.png",
            "title": "Affordable Prices",
            "text": "<p>We offer abayas starting at AED 250 up to AED 800. We believe our abaya designs should be available to everyone regardless of one’s budget.</p>"
          }
        },
        "item_why_2": {
          "type": "item",
          "settings": {
            "icon": "styles.png",
            "title": "Variety of Styles",
            "text": "<p>Beadwork, embroidery, lacework, lasercut, coat style, bisht, kloosh. You name it, we have it.</p>"
          }
        },
        "item_why_3": {
          "type": "item",
          "settings": {
            "icon": "fabrics.png",
            "title": "Premium Quality Fabrics",
            "text": "<p>We use high-quality abaya fabrics, such as silk, linen, organza, jacquard, crepe, and more. Our premium fabrics are sourced carefully to ensure durability and comfort.</p>"
          }
        },
        "item_why_4": {
          "type": "item",
          "settings": {
            "icon": "shipping.png",
            "title": "Free Shipping",
            "text": "<p>We offer free shipping for all abaya UAE orders above AED 999 (UAE only).</p>"
          }
        },
        "item_why_5": {
          "type": "item",
          "settings": {
            "icon": "exchange.png",
            "title": "Exchange Policy",
            "text": "<p>We don’t offer any refunds or returns. Head over to the CAS <a href=\"/policies/refund-policy\">refund policy</a>.</p>"
          }
        },
        "item_why_6": {
          "type": "item",
          "settings": {
            "icon": "support.png",
            "title": "Online Support",
            "text": "<p>For your convenience, we offer online support. Please click on the WhatsApp icon on the website to get in contact with any of our experienced support agents. We are also available on instagram as well as tiktok to answer your queries. An urgent matter? Call us on +971 6 551 8372.</p>"
          }
        },
        "item_why_7": {
          "type": "item",
          "settings": {
            "icon": "payment.png",
            "title": "Flexible Payment",
            "text": "<p>CAS accepts Visa, American Express, and Mastercard for online payments. We accept Tabby payments as well, an easy installment plan for you. Cash on Delivery option is available only for UAE residents.</p>"
          }
        },
        "item_why_8": {
          "type": "item",
          "settings": {
            "icon": "sustainability.png",
            "title": "Committed to sustainability",
            "text": "<p>We operate on a pre-order basis, which means we only use as many resources as we need according to the number of orders we receive.</p><p>From eco-friendly materials to thoughtful packaging, we always make sure that we leave a lighter carbon footprint on our planet.</p>"
          }
        },
        "item_why_9": {
          "type": "item",
          "settings": {
            "icon": "donation.png",
            "title": "AED 10 donation every month",
            "text": "<p>Every abaya sold helps fuel a meaningful AED 10 donation to Red Crescent every month! #CASWearHope</p>"
          }
        }
      },
