{%- doc -%}
  Menu drawer content, as on the live store: logo and close button on top, the menu links
  (items with a sub-menu open with + / −), then Log in, Create account and Search.
  Rendered inside header-drawer.liquid's .menu-drawer, so <header-drawer> still opens and closes it.
  The + / − buttons are handled in cb-theme.js ([data-cb-mdrawer-toggle]).

  @param {object} linklist - The menu to show
  @param {string} [id_prefix] - Makes the sub-menu ids unique on the page
{%- enddoc -%}

{%- liquid
  assign logo = settings.cb_drawer_logo | default: settings.logo
  assign logo_width = settings.cb_drawer_logo_width | default: 40
  assign highlight = settings.cb_drawer_highlight | strip | downcase
  assign prefix = id_prefix | default: 'menu' | append: '-cb-mdrawer'
-%}

<div class="cb-mdrawer__head">
  <a class="cb-mdrawer__logo" href="{{ routes.root_url }}">
    {%- if logo != blank -%}
      {%- liquid
        assign logo_width_2x = logo_width | times: 2
        assign logo_style = 'width: ' | append: logo_width | append: 'px'
      -%}
      {{ logo | image_url: width: logo_width_2x | image_tag: alt: shop.name, loading: 'lazy', style: logo_style }}
    {%- else -%}
      <span class="cb-mdrawer__logo-text">{{ shop.name }}</span>
    {%- endif -%}
  </a>
  <button type="button" class="cb-mdrawer__close" aria-label="{{ 'actions.close' | t }}" on:click="/close">
    <svg viewBox="0 0 192 192" aria-hidden="true" focusable="false"><path d="M150 42 42 150M150 150 42 42"/></svg>
  </button>
</div>

<nav class="cb-mdrawer__nav" aria-label="{{ 'accessibility.header_navigation_label' | t }}">
  <ul class="cb-mdrawer__list" role="list">
    {%- for link in linklist.links -%}
      {%- liquid
        assign title_key = link.title | strip | downcase
        assign sub_id = prefix | append: '-' | append: forloop.index
      -%}
      <li class="cb-mdrawer__item">
        <div class="cb-mdrawer__row">
          <a
            class="cb-mdrawer__link{% if highlight != blank and title_key == highlight %} is-highlight{% endif %}"
            href="{{ link.url }}"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{- link.title -}}
          </a>
          {%- if link.links != blank -%}
            <button type="button" class="cb-mdrawer__toggle" aria-expanded="false" aria-controls="{{ sub_id }}" data-cb-mdrawer-toggle>
              <span class="visually-hidden">{{ link.title }}</span>
              <svg class="cb-mdrawer__plus" viewBox="0 0 192 192" aria-hidden="true" focusable="false"><path d="M30 96h132M96 30v132"/></svg>
              <svg class="cb-mdrawer__minus" viewBox="0 0 192 192" aria-hidden="true" focusable="false"><path d="M30 96h132"/></svg>
            </button>
          {%- endif -%}
        </div>
        {%- if link.links != blank -%}
          <div class="cb-mdrawer__sub" id="{{ sub_id }}">
            <div class="cb-mdrawer__sub-inner">
              <ul class="cb-mdrawer__sublist" role="list">
                {%- for child in link.links -%}
                  <li>
                    <a
                      class="cb-mdrawer__sublink"
                      href="{{ child.url }}"
                      {% if child.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- child.title -}}
                    </a>
                    {%- if child.links != blank -%}
                      <ul class="cb-mdrawer__sublist cb-mdrawer__sublist--deep" role="list">
                        {%- for grandchild in child.links -%}
                          <li>
                            <a class="cb-mdrawer__sublink" href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>

  {%- if settings.cb_drawer_account_links or settings.cb_drawer_search_link -%}
    <ul class="cb-mdrawer__extra" role="list">
      {%- if settings.cb_drawer_account_links and shop.customer_accounts_enabled -%}
        {%- if customer -%}
          <li><a class="cb-mdrawer__sublink" href="{{ routes.account_url }}">My account</a></li>
          <li><a class="cb-mdrawer__sublink" href="{{ routes.account_logout_url }}">Log out</a></li>
        {%- else -%}
          <li><a class="cb-mdrawer__sublink" href="{{ routes.account_login_url }}">Log in</a></li>
          <li><a class="cb-mdrawer__sublink" href="{{ routes.account_register_url }}">Create account</a></li>
        {%- endif -%}
      {%- endif -%}
      {%- if settings.cb_drawer_search_link -%}
        <li><a class="cb-mdrawer__sublink" href="{{ routes.search_url }}">Search</a></li>
      {%- endif -%}
    </ul>
  {%- endif -%}
</nav>
