{%- doc -%}
  Line icons used by cb-* sections. Stroke follows currentColor.

  @param {string} icon - Icon name
  @param {string} [class] - Extra class
{%- enddoc -%}

{%- capture paths -%}
  {%- case icon -%}
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.75"/><circle cx="17" cy="17.5" r="1.75"/>
    {%- when 'star' -%}
      <path d="m12 3.5 2.6 5.3 5.9.9-4.25 4.1 1 5.85L12 16.9l-5.25 2.75 1-5.85L3.5 9.7l5.9-.9z"/>
    {%- when 'shield' -%}
      <path d="M12 3 4.5 6v5.5c0 4.5 3.2 8.2 7.5 9.5 4.3-1.3 7.5-5 7.5-9.5V6z"/><path d="m8.75 12 2.25 2.25 4.25-4.5"/>
    {%- when 'hand' -%}
      <path d="M8 12V5.75a1.25 1.25 0 0 1 2.5 0V11"/><path d="M10.5 10.5V4.25a1.25 1.25 0 0 1 2.5 0v6.25"/><path d="M13 10.5V5.25a1.25 1.25 0 0 1 2.5 0V12"/><path d="M15.5 9.5a1.25 1.25 0 0 1 2.5 0V14a7 7 0 0 1-7 7h-.5a6 6 0 0 1-4.9-2.55L3.4 15.3a1.3 1.3 0 0 1 2-1.6L8 16.25V12"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.35-7.5-10.1A4.15 4.15 0 0 1 12 7.4a4.15 4.15 0 0 1 7.5 2.5C19.5 15.65 12 20 12 20z"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15"/><path d="M5 19c3-4 6-6.5 9.5-8.5"/>
    {%- when 'card' -%}
      <rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M3 9.5h18M6.5 14.5h4"/>
    {%- when 'chat' -%}
      <path d="M4 5.5h16v10H9l-5 4z"/><path d="M8 10.5h.01M12 10.5h.01M16 10.5h.01"/>
    {%- when 'return' -%}
      <path d="M9 7 4.5 11.5 9 16"/><path d="M4.5 11.5H15a4.5 4.5 0 0 1 0 9h-2"/>
    {%- when 'gift' -%}
      <rect x="3.5" y="8.5" width="17" height="4"/><path d="M5 12.5v8h14v-8M12 8.5v12"/><path d="M12 8.5S10.5 4 8.25 4a2.25 2.25 0 0 0 0 4.5M12 8.5S13.5 4 15.75 4a2.25 2.25 0 0 1 0 4.5"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.5 2.5 3.5 5.5 3.5 8.5s-1 6-3.5 8.5c-2.5-2.5-3.5-5.5-3.5-8.5s1-6 3.5-8.5z"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'cross' -%}
      <path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/>
    {%- when 'scissors' -%}
      <circle cx="6.5" cy="7" r="2.5"/><circle cx="6.5" cy="17" r="2.5"/><path d="M8.6 8.4 20 17.5M8.6 15.6 20 6.5"/>
    {%- when 'ruler' -%}
      <path d="m3.5 15.5 12-12 5 5-12 12z"/><path d="m7.5 11.5 2 2M10.5 8.5l2 2M13.5 5.5l2 2"/>
    {%- when 'phone' -%}
      <path d="M5 4.5h3.5l1.5 4-2 1.5a10 10 0 0 0 6 6l1.5-2 4 1.5V19a1.5 1.5 0 0 1-1.5 1.5A15.5 15.5 0 0 1 3.5 6 1.5 1.5 0 0 1 5 4.5z"/>
    {%- when 'home' -%}
      <path d="M4 10.5 12 4l8 6.5V20h-5.5v-5.5h-5V20H4z"/>
    {%- when 'sparkle' -%}
      <path d="M12 3.5c.6 4.4 2.1 5.9 6.5 6.5-4.4.6-5.9 2.1-6.5 6.5-.6-4.4-2.1-5.9-6.5-6.5 4.4-.6 5.9-2.1 6.5-6.5z"/><path d="M18.5 15.5c.25 1.75.75 2.25 2.5 2.5-1.75.25-2.25.75-2.5 2.5-.25-1.75-.75-2.25-2.5-2.5 1.75-.25 2.25-.75 2.5-2.5z"/>
    {%- when 'box' -%}
      <path d="M3.5 7.5 12 3.5l8.5 4v9L12 20.5l-8.5-4z"/><path d="M3.5 7.5 12 11.5l8.5-4M12 11.5v9"/>
    {%- when 'tag' -%}
      <path d="M3.5 12.5v-8h8l9 9-8 8z"/><circle cx="8" cy="8.5" r="1.25"/>
    {%- when 'map-pin' -%}
      <path d="M12 21s-6.5-6.1-6.5-11a6.5 6.5 0 0 1 13 0c0 4.9-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.25"/>
    {%- when 'mail' -%}
      <rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>
    {%- when 'chevron-down' -%}
      <path d="m5 9 7 7 7-7"/>
    {%- when 'rack' -%}
      <path d="M4 4.5h16M5.5 4.5v15M18.5 4.5v15"/><path d="M8.5 4.5v8.5M11.5 4.5v8.5M14.5 4.5v6.5"/>
    {%- when 'calendar' -%}
      <rect x="3.5" y="5" width="17" height="15" rx="1.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/>
    {%- when 'users' -%}
      <circle cx="9" cy="8.5" r="3"/><path d="M3.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5"/><circle cx="16.5" cy="9.5" r="2.5"/><path d="M15.5 14.2c3 .1 5 1.9 5 4.8"/>
    {%- when 'cart' -%}
      <path d="M2.5 4h2.6l2.3 10.5h10.9l2.2-7.5H6.2"/><circle cx="9" cy="19" r="1.4"/><circle cx="17" cy="19" r="1.4"/>
    {%- when 'arrow-right' -%}
      <path d="M4 12h16m0 0-5-5m5 5-5 5"/>
    {%- when 'close' -%}
      <path d="M5 5l14 14M19 5 5 19"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8.5"/><path d="m8.5 12 2.5 2.5 4.5-5"/>
  {%- endcase -%}
{%- endcapture -%}

<svg
  class="cb-icon cb-icon--{{ icon }}{% if class != blank %} {{ class }}{% endif %}"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {{- paths -}}
</svg>
