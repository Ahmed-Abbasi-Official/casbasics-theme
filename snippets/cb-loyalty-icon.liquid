{%- doc -%}
  Bold line icons for the loyalty page (ways to earn / redeem, how it works). Stroke follows currentColor.

  @param {string} icon - Icon name
  @param {string} [class] - Extra class
{%- enddoc -%}

<svg
  class="cb-loyalty-icon{% if class != blank %} {{ class }}{% endif %}"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'bag' -%}
      <path d="M5.5 8h13l-1 12.5h-11L5.5 8Z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/><path d="M9.5 12.5a2.5 2.5 0 0 0 5 0"/>
    {%- when 'smile' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M8.5 14a4 4 0 0 0 7 0"/><path d="M9.2 9.5h.01M14.8 9.5h.01" stroke-width="2.4"/>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17"/><path d="M12 3.5c2.2 2.3 3.3 5.1 3.3 8.5S14.2 18.2 12 20.5c-2.2-2.3-3.3-5.1-3.3-8.5S9.8 5.8 12 3.5Z"/>
    {%- when 'share' -%}
      <path d="M12 15V3.5"/><path d="m8 7.5 4-4 4 4"/><path d="M8.5 11H6v9.5h12V11h-2.5"/>
    {%- when 'thumbs-up' -%}
      <path d="M7 11v9.5H3.5V11H7Z"/><path d="M7 11l3.6-6.6a1.9 1.9 0 0 1 3.5 1.3L13.4 10H19a2 2 0 0 1 2 2.3l-1.2 6.5a2 2 0 0 1-2 1.7H7"/>
    {%- when 'heart-plus' -%}
      <path d="M13.5 18.5 12 20l-7.3-7.3a4.7 4.7 0 0 1 7.3-5.9 4.7 4.7 0 0 1 8 4.4"/><path d="M18 14v6M15 17h6"/>
    {%- when 'user' -%}
      <circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="10" r="3"/><path d="M6.6 17.6a6.5 6.5 0 0 1 10.8 0"/>
    {%- when 'user-check' -%}
      <circle cx="10.5" cy="8" r="4"/><path d="M3.5 20a7 7 0 0 1 12.3-4.6"/><path d="m15.5 19 2 2 4-4"/>
    {%- when 'mail-check' -%}
      <path d="M20.5 12V5.5h-17v13H12"/><path d="m3.5 5.5 8.5 6.5 8.5-6.5"/><path d="m15 18 2 2 4-4"/>
    {%- when 'basket' -%}
      <path d="M3 10h18l-2 10.5H5L3 10Z"/><path d="m8 10 4-6 4 6"/><path d="M12 15.2h.01" stroke-width="2.6"/>
    {%- when 'cake' -%}
      <path d="M4 20.5h16"/><path d="M5.5 20.5V15h13v5.5"/><path d="M7.5 15v-3.5h9V15"/><path d="M12 11.5V8.5"/><path d="M12 5.5h.01" stroke-width="2.6"/>
    {%- when 'card-star' -%}
      <rect x="3" y="7" width="18" height="12" rx="2"/><path d="M3 11h18"/><path d="m12 2.8.9 1.8 2 .3-1.4 1.4.3 2-1.8-.9-1.8.9.3-2-1.4-1.4 2-.3.9-1.8Z" stroke-width="1.2"/>
    {%- when 'gift' -%}
      <path d="M4.5 11h15v9.5h-15z"/><path d="M3 7h18v4H3z"/><path d="M12 7v13.5"/><path d="M12 7C10.6 4.2 7 4 7 5.8 7 7.3 12 7 12 7Zm0 0c1.4-2.8 5-3 5-1.2C17 7.3 12 7 12 7Z"/>
    {%- when 'dollar' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M14.8 9.4c-.4-1-1.5-1.6-2.8-1.6-1.6 0-2.8.8-2.8 2 0 2.9 5.7 1.5 5.7 4.2 0 1.2-1.2 2.1-2.9 2.1-1.4 0-2.6-.6-3-1.6"/><path d="M12 6.3v11.4"/>
    {%- when 'percent' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="m9 15 6-6"/><path d="M9.3 9.3h.01M14.7 14.7h.01" stroke-width="2.6"/>
    {%- when 'arrow-circle' -%}
      <circle cx="12" cy="12" r="9"/><path d="M8 12h8"/><path d="m13 9 3 3-3 3"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8.5"/>
  {%- endcase -%}
</svg>
