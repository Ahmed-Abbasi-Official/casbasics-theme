{%- doc -%}
  Free shipping progress bar shown at the top of the cart summary (drawer and cart page).
  Driven by theme settings > Casbasics: free shipping. Only shown for the store's base
  currency, because Liquid cannot convert the threshold into other presentment currencies.
{%- enddoc -%}

{%- liquid
  assign threshold = settings.cb_free_shipping_threshold | default: 0
  assign show_bar = false
  if settings.cb_free_shipping_enable and threshold > 0 and cart.item_count > 0 and cart.currency.iso_code == shop.currency
    assign show_bar = true
  endif
-%}

{%- if show_bar -%}
  {%- liquid
    assign threshold_cents = threshold | times: 100
    assign remaining = threshold_cents | minus: cart.total_price
    assign progress = cart.total_price | times: 100 | divided_by: threshold_cents
    if progress > 100
      assign progress = 100
    endif
  -%}
  <div class="cb-free-shipping" role="status">
    <p class="cb-free-shipping__message">
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{ settings.cb_free_shipping_message | replace: '[amount]', remaining_money }}
      {%- else -%}
        {{ settings.cb_free_shipping_success }}
      {%- endif -%}
    </p>
    <div class="cb-free-shipping__track" aria-hidden="true">
      <span class="cb-free-shipping__fill" style="--cb-progress: {{ progress }}%;"></span>
    </div>
  </div>
{%- endif -%}
