{%- liquid
  assign grid_class = 'cb-grid'
  if section.settings.carousel_mobile
    assign grid_class = 'cb-grid cb-grid--carousel'
  endif
  assign sizes = '(min-width: 750px) calc(100vw / ' | append: section.settings.columns | append: '), 85vw'
-%}

<div
  class="cb-section cb-columns cb-align-{{ section.settings.alignment }}"
  style="{% render 'cb-section-style', settings: section.settings %}"
>
  <div class="cb-container">
    {%- if section.settings.heading != blank -%}
      <div class="cb-header">
        <h2 class="cb-heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.show_line -%}
          <span class="cb-heading-line"></span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="{{ grid_class }}"
      style="--cb-cols: {{ section.settings.columns }}; --cb-cols-mobile: 1; --cb-gap: {{ section.settings.gap }}px; --cb-gap-mobile: 32px;"
    >
      {%- for block in section.blocks -%}
        <div class="cb-columns__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank or section.settings.show_placeholders -%}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="cb-hover-scale" tabindex="-1">{%- endif -%}
            <div class="cb-media cb-columns__media cb-ratio-{{ section.settings.image_ratio }}">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag: loading: 'lazy', sizes: sizes, widths: '360, 540, 720, 900, 1200'
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h3 class="cb-columns__title">{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="cb-rte">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.link_label != blank -%}
            <a class="cb-text-link" href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Columns",
  "tag": "section",
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Column" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post.</p>"
        },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "show_line", "label": "Show line under heading", "default": false },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "gap", "label": "Gap", "min": 8, "max": 64, "step": 4, "unit": "px", "default": 32 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "classic", "label": "Landscape (5:4)" },
        { "value": "wide", "label": "Wide" },
        { "value": "logo", "label": "Logo strip (press logos)" }
      ],
      "default": "landscape"
    },
    { "type": "checkbox", "id": "show_placeholders", "label": "Show image placeholders when empty", "default": true },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "checkbox", "id": "carousel_mobile", "label": "Swipe carousel on mobile", "default": false },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 60 }
  ],
  "presets": [
    {
      "name": "Columns",
      "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }]
    }
  ]
}
{% endschema %}
