{%- liquid
  assign container = 'cb-container'
  if section.settings.width == 'narrow'
    assign container = 'cb-container cb-container--narrow'
  elsif section.settings.width == 'slim'
    assign container = 'cb-container cb-container--slim'
  elsif section.settings.width == 'compact'
    assign container = 'cb-container cb-container--compact'
  endif
-%}

<div
  class="cb-section cb-referral-section"
  style="{% render 'cb-section-style', settings: section.settings %}"
>
  <div class="{{ container }}">
    <div class="cb-referral-card">
      {%- if section.settings.heading != blank -%}
        <h2 class="cb-referral__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <p class="cb-referral__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'cb-referral-form' -%}
        <input type="hidden" name="contact[tags]" value="referral_program, newsletter">

        {%- if form.posted_successfully? -%}
          <div class="cb-referral-success" role="status">
            <p class="cb-referral-success__title">🎉 Thank you!</p>
            <p class="cb-referral-success__text">
              Your 10% discount link has been generated and sent to your email address.
            </p>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="cb-referral-error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="cb-referral-field">
            <label for="cb-referral-email-{{ section.id }}" class="cb-referral-label">
              {{ section.settings.email_label | default: 'Email' }}
              <span class="cb-referral-required" aria-hidden="true">*</span>
            </label>
            <input
              id="cb-referral-email-{{ section.id }}"
              type="email"
              name="contact[email]"
              class="cb-referral-input"
              placeholder="{{ section.settings.email_placeholder | default: 'Your email' }}"
              value="{{ form.email }}"
              required
              autocomplete="email"
            >
          </div>

          <div class="cb-referral-field">
            <label for="cb-referral-name-{{ section.id }}" class="cb-referral-label">
              {{ section.settings.name_label | default: 'Name' }}
              <span class="cb-referral-required" aria-hidden="true">*</span>
            </label>
            <input
              id="cb-referral-name-{{ section.id }}"
              type="text"
              name="contact[note][Full Name]"
              class="cb-referral-input"
              placeholder="{{ section.settings.name_placeholder | default: 'Your name' }}"
              required
              autocomplete="name"
            >
          </div>

          <button type="submit" class="cb-referral-submit">
            {{ section.settings.button_label | default: 'Get Discount Link' }}
          </button>

          <div class="cb-referral-footer">
            {%- if section.settings.min_purchase != blank -%}
              <p class="cb-referral-min">{{ section.settings.min_purchase }}</p>
            {%- endif -%}
            {%- if section.settings.terms_text != blank -%}
              <div class="cb-referral-terms">{{ section.settings.terms_text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{%- comment -%} Poppins, as in the live store's Loox referral form {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap">

<style>
  /* Matches the live store's Loox referral form: Poppins, 26px bold heading, 18px subtitle,
     14px semibold labels, 50px inputs, 48px black button, 10px small print; 32px inner padding */
  .cb-referral-section {
    padding-top: var(--cb-pt, 60px);
    padding-bottom: var(--cb-pb, 60px);
    background-color: var(--cb-bg, inherit);
    color: var(--cb-fg, inherit);
  }

  .cb-referral-section > .cb-container:not(.cb-container--narrow):not(.cb-container--slim) {
    max-width: calc(1305px + var(--page-margin, 16px) * 2);
  }

  .cb-referral-card {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 32px;
    box-sizing: border-box;
    font-family: Poppins, sans-serif;
    font-size: 14px;
    line-height: 1.42857;
    color: #000;
  }

  .cb-referral__heading {
    margin: 0 0 8px;
    font-family: inherit;
    font-size: 26px;
    font-weight: 700;
    line-height: 32px;
    letter-spacing: 0;
    text-align: left;
    color: #000;
  }

  .cb-referral__subtext {
    margin: 0 0 20px;
    font-size: 18px;
    font-weight: 400;
    line-height: 22px;
    text-align: left;
    color: #404040;
  }

  .cb-referral-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  .cb-referral-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    text-align: left;
  }

  .cb-referral-label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    color: #000;
  }

  .cb-referral-required {
    font-weight: 400;
    color: #c10909;
  }

  .cb-referral-input {
    width: 100%;
    height: 50px;
    padding: 12px 16px;
    box-sizing: border-box;
    border: 1px solid #c9cdd4;
    border-radius: 8px;
    background-color: transparent !important;
    font-family: inherit;
    font-size: 16px;
    line-height: 24px;
    color: #000;
    outline: none;
  }

  .cb-referral-input::placeholder {
    color: #595959;
    opacity: 1;
  }

  .cb-referral-input:focus {
    border-color: #1361e8;
    background-color: transparent !important;
  }

  .cb-referral-submit {
    display: block;
    width: 100%;
    height: 48px;
    padding: 10px 12px;
    box-sizing: border-box;
    border: 2px solid #000;
    border-radius: 8px;
    background-color: #000;
    font-family: inherit;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #fff;
    cursor: pointer;
    transition: background-color 0.1s ease-in-out, border-color 0.1s ease-in-out;
  }

  .cb-referral-submit:hover {
    border-color: #222;
    background-color: #222;
  }

  .cb-referral-footer {
    margin-top: -12px;
    font-size: 10px;
    line-height: 21px;
    text-align: center;
    color: #595959;
  }

  .cb-referral-min {
    margin: 0;
    font-size: 10px;
    color: #545454;
  }

  .cb-referral-terms {
    margin: 0;
    font-size: 10px;
    line-height: 21px;
    color: #595959;
  }

  .cb-referral-terms p {
    margin: 0;
  }

  .cb-referral-terms a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: auto;
  }

  .cb-referral-success {
    padding: 24px;
    border: 1px solid #c9cdd4;
    border-radius: 8px;
    background: #f7f6f3;
    text-align: center;
  }

  .cb-referral-success__title {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 600;
    color: #000;
  }

  .cb-referral-success__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: #404040;
  }

  .cb-referral-error {
    margin-bottom: 12px;
    padding: 12px 16px;
    border: 1px solid #f8b4b4;
    border-radius: 8px;
    background: #fdf2f2;
    font-size: 14px;
    color: #9b1c1c;
  }
</style>

{% schema %}
{
  "name": "Referral discount",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "normal", "label": "Normal (matches FAQ)" },
        { "value": "compact", "label": "Compact" },
        { "value": "narrow", "label": "Narrow" },
        { "value": "slim", "label": "Slim" }
      ],
      "default": "normal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Give 10%, Get AED 30"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Share a 10% discount link with your friends and family, and earn AED 30 for every purchase they make."
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name placeholder",
      "default": "Your name"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get Discount Link"
    },
    {
      "type": "text",
      "id": "min_purchase",
      "label": "Minimum purchase text",
      "default": "Minimum purchase amount: AED 350"
    },
    {
      "type": "richtext",
      "id": "terms_text",
      "label": "Terms text",
      "default": "<p>By submitting, I acknowledge the <a href=\"/policies/terms-of-service\">Terms of Service</a> and <a href=\"/policies/privacy-policy\">Privacy Policy</a></p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Referral discount"
    }
  ]
}
{% endschema %}