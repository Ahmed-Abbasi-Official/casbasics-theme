{%- liquid
  assign container = 'cb-container'
  if section.settings.width == 'narrow'
    assign container = 'cb-container cb-container--narrow'
  elsif section.settings.width == 'slim'
    assign container = 'cb-container cb-container--slim'
  elsif section.settings.width == 'compact'
    assign container = 'cb-container cb-container--compact'
  endif
-%}

<div
  class="cb-section cb-referral-section"
  style="{% render 'cb-section-style', settings: section.settings %}"
>
  <div class="{{ container }}">
    <div class="cb-referral-card">
      {%- if section.settings.heading != blank -%}
        <h2 class="cb-referral__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <p class="cb-referral__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'cb-referral-form' -%}
        <input type="hidden" name="contact[tags]" value="referral_program, newsletter">

        {%- if form.posted_successfully? -%}
          <div class="cb-referral-success" role="status">
            <p class="cb-referral-success__title">🎉 Thank you!</p>
            <p class="cb-referral-success__text">
              Your 10% discount link has been generated and sent to your email address.
            </p>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="cb-referral-error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="cb-referral-field">
            <label for="cb-referral-email-{{ section.id }}" class="cb-referral-label">
              {{ section.settings.email_label | default: 'Email' }}
              <span class="cb-referral-required" aria-hidden="true">*</span>
            </label>
            <input
              id="cb-referral-email-{{ section.id }}"
              type="email"
              name="contact[email]"
              class="cb-referral-input"
              placeholder="{{ section.settings.email_placeholder | default: 'Your email' }}"
              value="{{ form.email }}"
              required
              autocomplete="email"
            >
          </div>

          <div class="cb-referral-field">
            <label for="cb-referral-name-{{ section.id }}" class="cb-referral-label">
              {{ section.settings.name_label | default: 'Name' }}
              <span class="cb-referral-required" aria-hidden="true">*</span>
            </label>
            <input
              id="cb-referral-name-{{ section.id }}"
              type="text"
              name="contact[note][Full Name]"
              class="cb-referral-input"
              placeholder="{{ section.settings.name_placeholder | default: 'Your name' }}"
              required
              autocomplete="name"
            >
          </div>

          <button type="submit" class="cb-referral-submit">
            {{ section.settings.button_label | default: 'Get Discount Link' }}
          </button>

          <div class="cb-referral-footer">
            {%- if section.settings.min_purchase != blank -%}
              <p class="cb-referral-min">{{ section.settings.min_purchase }}</p>
            {%- endif -%}
            {%- if section.settings.terms_text != blank -%}
              <div class="cb-referral-terms">{{ section.settings.terms_text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

<style>
  .cb-referral-section {
    padding-top: var(--cb-pt, 40px);
    padding-bottom: var(--cb-pb, 64px);
    background-color: var(--cb-bg, inherit);
    color: var(--cb-fg, inherit);
  }

  .cb-referral-section > .cb-container:not(.cb-container--narrow):not(.cb-container--slim) {
    max-width: calc(1305px + var(--page-margin, 16px) * 2);
  }

  .cb-referral-card {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .cb-referral__heading {
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.25;
    color: #000;
    margin: 0 0 4px 0;
    letter-spacing: 0;
    text-align: left;
  }

  .cb-referral__subtext {
    font-size: 1.125rem;
    line-height: 1.5;
    color: #2b2b2b;
    margin: 0 0 22px 0;
    text-align: left;
  }

  .cb-referral-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }

  .cb-referral-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: left;
    width: 100%;
  }

  .cb-referral-label {
    font-size: 1rem;
    font-weight: 500;
    color: #0b0b0b;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cb-referral-required {
    color: #c4161c;
    font-weight: 500;
  }

  .cb-referral-input {
    width: 100%;
    height: 50px;
    padding: 12px 17px;
    font-family: inherit;
    font-size: 1.05rem;
    border: 1px solid #d9d6d1;
    border-radius: 12px;
    background-color: transparent !important;
    color: #0b0b0b;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .cb-referral-input::placeholder {
    color: #4a4a4a;
    opacity: 1;
  }

  .cb-referral-input:focus {
    border-color: #0b0b0b;
    background-color: transparent !important;
    box-shadow: 0 0 0 1px #0b0b0b;
  }

  .cb-referral-submit {
    display: block;
    width: 100%;
    height: 50px;
    padding: 0 24px;
    margin-top: 2px;
    background-color: #000;
    color: #fff;
    border: none;
    border-radius: 12px;
    font-family: inherit;
    font-size: 1.05rem;
    font-weight: 500;
    cursor: pointer;
    box-sizing: border-box;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  .cb-referral-submit:hover {
    background-color: #222;
  }

  .cb-referral-footer {
    text-align: center;
    margin-top: 4px;
  }

  .cb-referral-min {
    font-size: 0.68rem;
    color: #3d3d3d;
    margin: 0 0 4px 0;
  }

  .cb-referral-terms {
    font-size: 0.68rem;
    color: #3d3d3d;
    line-height: 1.4;
    margin: 0;
  }

  .cb-referral-terms p {
    margin: 0;
  }

  .cb-referral-terms a {
    color: #0b0b0b;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cb-referral-success {
    padding: 24px;
    background: #f7f6f3;
    border: 1px solid #d2ccc4;
    border-radius: 12px;
    text-align: center;
  }

  .cb-referral-success__title {
    font-size: 1.1rem;
    font-weight: 500;
    margin: 0 0 8px 0;
    color: #0b0b0b;
  }

  .cb-referral-success__text {
    font-size: 0.9rem;
    color: #3d3d3d;
    margin: 0;
    line-height: 1.5;
  }

  .cb-referral-error {
    padding: 12px 16px;
    background: #fdf2f2;
    border: 1px solid #f8b4b4;
    border-radius: 12px;
    color: #9b1c1c;
    font-size: 0.85rem;
    margin-bottom: 12px;
  }
</style>

{% schema %}
{
  "name": "Referral discount",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "normal", "label": "Normal (matches FAQ)" },
        { "value": "compact", "label": "Compact" },
        { "value": "narrow", "label": "Narrow" },
        { "value": "slim", "label": "Slim" }
      ],
      "default": "normal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Give 10%, Get AED 30"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Share a 10% discount link with your friends and family, and earn AED 30 for every purchase they make."
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name placeholder",
      "default": "Your name"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get Discount Link"
    },
    {
      "type": "text",
      "id": "min_purchase",
      "label": "Minimum purchase text",
      "default": "Minimum purchase amount: AED 350"
    },
    {
      "type": "richtext",
      "id": "terms_text",
      "label": "Terms text",
      "default": "<p>By submitting, I acknowledge the <a href=\"/policies/terms-of-service\">Terms of Service</a> and <a href=\"/policies/privacy-policy\">Privacy Policy</a></p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Referral discount"
    }
  ]
}
{% endschema %}