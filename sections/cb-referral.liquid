<div
  class="cb-section cb-referral-section"
  style="{% render 'cb-section-style', settings: section.settings %}"
>
  <div class="cb-container">
    <div class="cb-referral-card">
      {%- if section.settings.heading != blank -%}
        <h2 class="cb-referral__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <p class="cb-referral__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'cb-referral-form' -%}
        <input type="hidden" name="contact[tags]" value="referral_program, newsletter">

        {%- if form.posted_successfully? -%}
          <div class="cb-referral-success" role="status">
            <p class="cb-referral-success__title">🎉 Thank you!</p>
            <p class="cb-referral-success__text">
              Your 10% discount link has been generated and sent to your email address.
            </p>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="cb-referral-error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="cb-referral-field">
            <label for="cb-referral-email-{{ section.id }}" class="cb-referral-label">
              {{ section.settings.email_label | default: 'Email' }}
              <span class="cb-referral-required" aria-hidden="true">*</span>
            </label>
            <input
              id="cb-referral-email-{{ section.id }}"
              type="email"
              name="contact[email]"
              class="cb-referral-input"
              placeholder="{{ section.settings.email_placeholder | default: 'Your email' }}"
              value="{{ form.email }}"
              required
              autocomplete="email"
            >
          </div>

          <div class="cb-referral-field">
            <label for="cb-referral-name-{{ section.id }}" class="cb-referral-label">
              {{ section.settings.name_label | default: 'Name' }}
              <span class="cb-referral-required" aria-hidden="true">*</span>
            </label>
            <input
              id="cb-referral-name-{{ section.id }}"
              type="text"
              name="contact[note][Full Name]"
              class="cb-referral-input"
              placeholder="{{ section.settings.name_placeholder | default: 'Your name' }}"
              required
              autocomplete="name"
            >
          </div>

          <button type="submit" class="cb-referral-submit">
            {{ section.settings.button_label | default: 'Get Discount Link' }}
          </button>

          <div class="cb-referral-footer">
            {%- if section.settings.min_purchase != blank -%}
              <p class="cb-referral-min">{{ section.settings.min_purchase }}</p>
            {%- endif -%}
            {%- if section.settings.terms_text != blank -%}
              <div class="cb-referral-terms">{{ section.settings.terms_text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

<style>
  .cb-referral-section {
    padding-top: var(--cb-pt, 64px);
    padding-bottom: var(--cb-pb, 64px);
    background-color: var(--cb-bg, inherit);
    color: var(--cb-fg, inherit);
  }

  .cb-referral-card {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 16px;
    box-sizing: border-box;
  }

  .cb-referral__heading {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 700;
    line-height: 1.25;
    color: #0b0b0b;
    margin: 0 0 10px 0;
    letter-spacing: -0.01em;
  }

  .cb-referral__subtext {
    font-size: 0.95rem;
    line-height: 1.55;
    color: #4a4641;
    margin: 0 0 24px 0;
  }

  .cb-referral-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cb-referral-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
  }

  .cb-referral-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #0b0b0b;
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .cb-referral-required {
    color: #d02e2e;
    font-weight: 700;
  }

  .cb-referral-input {
    width: 100%;
    height: 48px;
    padding: 10px 16px;
    font-size: 0.95rem;
    border: 1px solid #d2ccc4;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.45);
    color: #0b0b0b;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }

  .cb-referral-input::placeholder {
    color: #9a948d;
  }

  .cb-referral-input:focus {
    border-color: #0b0b0b;
    background-color: #ffffff;
    box-shadow: 0 0 0 1px #0b0b0b;
  }

  .cb-referral-submit {
    display: block;
    width: 100%;
    height: 50px;
    padding: 0 24px;
    margin-top: 4px;
    background-color: #0b0b0b;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  .cb-referral-submit:hover {
    background-color: #222222;
  }

  .cb-referral-footer {
    text-align: center;
    margin-top: 10px;
  }

  .cb-referral-min {
    font-size: 0.75rem;
    color: #76726c;
    margin: 0 0 6px 0;
  }

  .cb-referral-terms {
    font-size: 0.72rem;
    color: #76726c;
    line-height: 1.45;
    margin: 0;
  }

  .cb-referral-terms a {
    color: #0b0b0b;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cb-referral-success {
    padding: 24px;
    background: #f7f6f3;
    border: 1px solid #d2ccc4;
    border-radius: 8px;
    text-align: center;
  }

  .cb-referral-success__title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 8px 0;
    color: #0b0b0b;
  }

  .cb-referral-success__text {
    font-size: 0.9rem;
    color: #4a4641;
    margin: 0;
    line-height: 1.5;
  }

  .cb-referral-error {
    padding: 12px 16px;
    background: #fdf2f2;
    border: 1px solid #f8b4b4;
    border-radius: 8px;
    color: #9b1c1c;
    font-size: 0.85rem;
    margin-bottom: 12px;
  }
</style>

{% schema %}
{
  "name": "Referral discount",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Give 10%, Get AED 30"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Share a 10% discount link with your friends and family, and earn AED 30 for every purchase they make."
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name placeholder",
      "default": "Your name"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get Discount Link"
    },
    {
      "type": "text",
      "id": "min_purchase",
      "label": "Minimum purchase text",
      "default": "Minimum purchase amount: AED 350"
    },
    {
      "type": "richtext",
      "id": "terms_text",
      "label": "Terms text",
      "default": "<p>By submitting, I acknowledge the <a href=\"/policies/terms-of-service\">Terms of Service</a> and <a href=\"/policies/privacy-policy\">Privacy Policy</a></p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Referral discount"
    }
  ]
}
{% endschema %}
