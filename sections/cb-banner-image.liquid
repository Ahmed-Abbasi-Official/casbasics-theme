{%- liquid
  assign banner_h = '60vh'
  case section.settings.height
    when 'small'
      assign banner_h = '40vh'
    when 'medium'
      assign banner_h = '60vh'
    when 'large'
      assign banner_h = '75vh'
    when 'full'
      assign banner_h = '100svh'
  endcase

  assign h_align = 'center'
  case section.settings.horizontal_position
    when 'left'
      assign h_align = 'flex-start'
    when 'right'
      assign h_align = 'flex-end'
  endcase

  assign v_align = 'center'
  case section.settings.vertical_position
    when 'top'
      assign v_align = 'flex-start'
    when 'bottom'
      assign v_align = 'flex-end'
  endcase

  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
  assign has_mobile = false
  if section.settings.image_mobile != blank
    assign has_mobile = true
  endif

  assign is_first = false
  if section.index == 1
    assign is_first = true
  endif
-%}

<div
  class="cb-banner{% if section.settings.zoom %} cb-banner--zoom{% endif %}"
  style="{% render 'cb-section-style', settings: section.settings %} --cb-banner-h: {{ banner_h }}; --cb-overlay: {{ overlay }}; --cb-overlay-color: {{ section.settings.overlay_color | default: '#000000' }}; --cb-h: {{ h_align }}; --cb-v: {{ v_align }};"
>
  <div class="cb-banner__media">
    {%- if section.settings.image != blank -%}
      {%- liquid
        assign img_class = 'cb-banner__img'
        if has_mobile
          assign img_class = 'cb-banner__img cb-banner__img--has-mobile'
        endif
        if is_first
          assign loading = 'eager'
        else
          assign loading = 'lazy'
        endif
      -%}
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag: class: img_class, loading: loading, sizes: '100vw', widths: '750, 1100, 1500, 2000, 3000'
      }}
      {%- if has_mobile -%}
        {{
          section.settings.image_mobile
          | image_url: width: 1200
          | image_tag: class: 'cb-banner__img--mobile', loading: loading, sizes: '100vw', widths: '450, 750, 1200'
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="cb-banner__overlay"></div>

  <div class="cb-banner__content cb-container">
    <div class="cb-banner__box cb-align-{{ section.settings.text_alignment }}">
      {%- if section.settings.subheading != blank -%}
        <span class="cb-subheading">{{ section.settings.subheading }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        {%- if is_first and section.settings.heading_h1 -%}
          <h1 class="cb-banner__title">{{ section.settings.heading }}</h1>
        {%- else -%}
          <h2 class="cb-banner__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="cb-banner__text cb-rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
        <div class="cb-buttons">
          {%- if section.settings.button_label != blank -%}
            <a class="cb-btn cb-btn--light" href="{{ section.settings.button_link | default: '#' }}">
              {{- section.settings.button_label -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="cb-btn cb-btn--outline" href="{{ section.settings.button_link_2 | default: '#' }}">
              {{- section.settings.button_label_2 -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Banner image",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "large"
    },
    { "type": "checkbox", "id": "zoom", "label": "Zoom-out animation", "default": true },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 25 },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Banner heading" },
    { "type": "checkbox", "id": "heading_h1", "label": "Use as page title (H1) when first section", "default": true },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_label_2", "label": "Second button label" },
    { "type": "url", "id": "button_link_2", "label": "Second button link" },
    {
      "type": "select",
      "id": "horizontal_position",
      "label": "Content position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_position",
      "label": "Vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "middle"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Banner image" }]
}
{% endschema %}
