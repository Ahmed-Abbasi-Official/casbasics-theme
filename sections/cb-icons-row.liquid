{%- liquid
  assign cols = section.settings.columns
  if section.blocks.size < cols and section.blocks.size > 0
    assign cols = section.blocks.size
  endif
  assign mobile_cols = 1
  if section.settings.mobile_two_columns
    assign mobile_cols = 2
  endif

  assign box_style = ''
  if section.settings.box_color != blank and section.settings.box_color.alpha != 0
    assign box_style = '--cb-box-bg: ' | append: section.settings.box_color | append: ';'
  endif
-%}

<div
  class="cb-section cb-icons cb-icons--{{ section.settings.style }} cb-icons--{{ section.settings.layout }} cb-icons--cols-{{ cols }}"
  style="{% render 'cb-section-style', settings: section.settings %} {{ box_style }} --cb-icon-size: {{ section.settings.icon_size }}px;"
>
  <div class="cb-container">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="cb-icons__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="cb-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="cb-rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cb-icons__grid" style="--cb-cols: {{ cols }}; --cb-cols-mobile: {{ mobile_cols }};">
      {%- for block in section.blocks -%}
        <div class="cb-icons__item" {{ block.shopify_attributes }}>
          {%- if section.settings.show_numbers -%}
            <span class="cb-icons__number">{{ forloop.index }}</span>
          {%- elsif block.settings.image != blank -%}
            <span class="cb-icons__icon">
              {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </span>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="cb-icons__icon">{% render 'cb-icon', icon: block.settings.icon %}</span>
          {%- endif -%}
          <div>
            {%- if block.settings.title != blank -%}
              <h3 class="cb-icons__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="cb-icons__text cb-rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Icons row",
  "tag": "section",
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery truck" },
            { "value": "star", "label": "Star" },
            { "value": "shield", "label": "Shield" },
            { "value": "hand", "label": "Hand" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "card", "label": "Credit card" },
            { "value": "chat", "label": "Chat" },
            { "value": "return", "label": "Return" },
            { "value": "gift", "label": "Gift" },
            { "value": "clock", "label": "Clock" },
            { "value": "globe", "label": "Globe" },
            { "value": "check", "label": "Check" },
            { "value": "scissors", "label": "Scissors" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "phone", "label": "Phone" },
            { "value": "home", "label": "Home" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "box", "label": "Box" },
            { "value": "tag", "label": "Tag" },
            { "value": "map-pin", "label": "Map pin" },
            { "value": "mail", "label": "Mail" }
          ],
          "default": "star"
        },
        { "type": "image_picker", "id": "image", "label": "Custom icon image", "info": "Overrides the icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe this benefit in a sentence.</p>" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Intro text" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "borders", "label": "Borders" },
        { "value": "boxes", "label": "Boxes" }
      ],
      "default": "plain"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Icon layout",
      "options": [
        { "value": "center", "label": "Icon above, centered" },
        { "value": "inline", "label": "Icon left of text" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "mobile_two_columns", "label": "2 columns on mobile", "default": false },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 20, "max": 80, "step": 4, "unit": "px", "default": 36 },
    { "type": "checkbox", "id": "show_numbers", "label": "Show step numbers instead of icons", "default": false },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "box_color", "label": "Box background" },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [
    {
      "name": "Icons row",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Free shipping" } },
        { "type": "item", "settings": { "icon": "shield", "title": "Quality guaranteed" } },
        { "type": "item", "settings": { "icon": "hand", "title": "Hand finished" } }
      ]
    }
  ]
}
{% endschema %}
