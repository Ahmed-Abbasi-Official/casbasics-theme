{%- liquid
  assign raised = section.settings.raised | default: 0
  assign goal = section.settings.goal | default: 0
  assign progress = 0
  if goal > 0
    assign progress = raised | times: 100 | divided_by: goal
  endif
  if progress > 100
    assign progress = 100
  endif
  assign remaining = goal | minus: raised
  if remaining < 0
    assign remaining = 0
  endif

  assign bar_style = ''
  if section.settings.bar_color != blank and section.settings.bar_color.alpha != 0
    assign bar_style = '--cb-bar: ' | append: section.settings.bar_color | append: ';'
  endif
-%}

<div
  class="cb-section cb-goal-section"
  style="{% render 'cb-section-style', settings: section.settings %} {{ bar_style }}"
>
  <div class="cb-container">
    <cb-goal class="cb-goal">
      {%- if section.settings.heading != blank -%}
        <h2 class="cb-heading cb-heading--small">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="cb-goal__stats">
        <span>
          <span class="cb-goal__amount">{{ raised }} {{ section.settings.currency }}</span>
          {{ section.settings.raised_label }}
        </span>
        <span>{{ section.settings.goal_label }} {{ goal }} {{ section.settings.currency }}</span>
      </div>
      <div
        class="cb-goal__track"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="{{ progress }}"
        aria-label="{{ section.settings.heading | default: 'Progress' | escape }}"
      >
        <span class="cb-goal__fill" data-goal-fill data-progress="{{ progress }}%"></span>
      </div>
      <div class="cb-goal__meta">
        <span>{{ progress }}%</span>
        <span>{{ section.settings.remaining_label }} {{ remaining }} {{ section.settings.currency }}</span>
      </div>
      {%- if section.settings.text != blank -%}
        <div class="cb-rte" style="margin-top: 20px;">{{ section.settings.text }}</div>
      {%- endif -%}
    </cb-goal>
  </div>
</div>

{% schema %}
{
  "name": "Fundraising goal",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This month's campaign" },
    { "type": "number", "id": "raised", "label": "Amount raised", "default": 6500 },
    { "type": "number", "id": "goal", "label": "Goal", "default": 10000 },
    { "type": "text", "id": "currency", "label": "Currency label", "default": "AED" },
    { "type": "text", "id": "raised_label", "label": "Raised label", "default": "raised" },
    { "type": "text", "id": "goal_label", "label": "Goal label", "default": "Goal:" },
    { "type": "text", "id": "remaining_label", "label": "Remaining label", "default": "Remaining:" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bar_color", "label": "Bar" },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Fundraising goal" }]
}
{% endschema %}
