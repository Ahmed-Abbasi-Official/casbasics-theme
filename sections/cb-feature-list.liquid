{%- liquid
  assign cols = section.settings.columns
-%}

<div
  class="cb-section cb-features cb-features--{{ section.settings.layout }}"
  style="{% render 'cb-section-style', settings: section.settings %} --cb-accent: {{ section.settings.accent_color | default: '#6c0013' }};"
>
  <div class="cb-container cb-features__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="cb-features__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ul
      class="cb-features__grid"
      role="list"
      style="--cb-cols: {{ cols }}; --cb-gap: {{ section.settings.gap }}px;"
    >
      {%- for block in section.blocks -%}
        <li class="cb-features__item" {{ block.shopify_attributes }}>
          {%- if section.settings.layout == 'steps' -%}
            <span class="cb-features__number" aria-hidden="true">{{ forloop.index }}</span>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="cb-features__icon" aria-hidden="true">{%- render 'cb-icon', icon: block.settings.icon -%}</span>
          {%- endif -%}
          <div class="cb-features__body">
            {%- if block.settings.title != blank -%}
              <h3 class="cb-features__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="cb-features__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Feature list",
  "tag": "section",
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "info": "Not shown in the numbered steps layout",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "rack", "label": "Clothes rack" },
            { "value": "heart", "label": "Heart" },
            { "value": "home", "label": "Home" },
            { "value": "ruler", "label": "Measuring tape" },
            { "value": "gift", "label": "Gift" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "truck", "label": "Truck" },
            { "value": "chat", "label": "Chat" },
            { "value": "clock", "label": "Clock" },
            { "value": "star", "label": "Star" },
            { "value": "check", "label": "Check" }
          ],
          "default": "heart"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature title" },
        { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Describe the feature in a few words" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The visit" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "list", "label": "Icon list with lines" },
        { "value": "steps", "label": "Numbered steps" }
      ],
      "default": "list"
    },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "gap", "label": "Column gap", "min": 16, "max": 64, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_color", "label": "Icons and numbers", "default": "#6c0013" },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [
    {
      "name": "Feature list",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
