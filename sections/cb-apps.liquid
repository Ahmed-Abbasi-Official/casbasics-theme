<div
  class="cb-section cb-apps"
  style="{% render 'cb-section-style', settings: section.settings %}"
>
  <div class="cb-container{% if section.settings.full_width %} cb-container--full{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="cb-header">
        <h2 class="cb-heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {% render block %}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Apps",
  "tag": "section",
  "blocks": [{ "type": "@app" }],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Optional, e.g. for a reviews widget" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Apps" }]
}
{% endschema %}
