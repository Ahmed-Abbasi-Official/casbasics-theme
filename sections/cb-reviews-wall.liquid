{%- doc -%}
  Reviews page, like the live store's "CAS Reviews" page (Loox reviews wall): the page title,
  a header with the average stars and review count (opens the star breakdown, which filters
  by rating) and a sort menu, then the reviews as white cards in a masonry grid
  (2 to 6 columns by width), "Show more reviews", and a paragraph under it.
  Each review is a block; photos and videos show a dummy until one is picked.
{%- enddoc -%}

{%- liquid
  assign heading = section.settings.heading | default: page.title

  assign count_5 = section.settings.count_5 | remove: ',' | plus: 0
  assign count_4 = section.settings.count_4 | remove: ',' | plus: 0
  assign count_3 = section.settings.count_3 | remove: ',' | plus: 0
  assign count_2 = section.settings.count_2 | remove: ',' | plus: 0
  assign count_1 = section.settings.count_1 | remove: ',' | plus: 0
  assign count_sum = count_5 | plus: count_4 | plus: count_3 | plus: count_2 | plus: count_1 | at_least: 1
-%}

{%- comment -%} Poppins, the font of the Loox widget on the live store {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap">

<div
  class="cb-section cb-reviews-wall"
  style="{% render 'cb-section-style', settings: section.settings %}"
>
  <div class="cb-container cb-reviews-wall__container">
    {%- if section.settings.show_heading and heading != blank -%}
      <h1 class="cb-reviews-wall__title">{{ heading }}</h1>
    {%- endif -%}

    <div class="cb-reviews-wall__body">
      <cb-reviews-wall
        class="cb-rw"
        data-initial="{{ section.settings.initial_count }}"
        data-step="{{ section.settings.more_count }}"
      >
        <div class="cb-rw__header">
          <div class="cb-rw__summary">
            <button
              type="button"
              class="cb-rw__summary-button"
              aria-expanded="false"
              aria-controls="CbRwDist-{{ section.id }}"
              data-rw-toggle
            >
              <span class="cb-rw__stars cb-rw__stars--large" aria-hidden="true">
                {%- for i in (1..5) -%}
                  {%- render 'cb-review-star', fill: true -%}
                {%- endfor -%}
              </span>
              <span class="cb-rw__summary-text">
                <span>{{ section.settings.total_count }} {{ section.settings.reviews_label }}</span>
              </span>
              <span class="cb-rw__chevron" aria-hidden="true">
                <svg width="14" height="8" viewBox="0 0 14 8" fill="none" focusable="false"><path d="M1.1 1.1 7 7l5.9-5.9" stroke="currentColor" stroke-width="2"/></svg>
              </span>
            </button>
          </div>

          <div class="cb-rw__dropdown cb-rw__dist" id="CbRwDist-{{ section.id }}" hidden>
            <p class="cb-rw__average">
              {%- render 'cb-review-star', fill: true -%}
              {{- section.settings.average -}}
            </p>
            <table class="cb-rw__dist-table">
              <tbody>
                {%- for stars in (1..5) reversed -%}
                  {%- liquid
                    case stars
                      when 5
                        assign count = count_5
                        assign label = section.settings.count_5
                      when 4
                        assign count = count_4
                        assign label = section.settings.count_4
                      when 3
                        assign count = count_3
                        assign label = section.settings.count_3
                      when 2
                        assign count = count_2
                        assign label = section.settings.count_2
                      else
                        assign count = count_1
                        assign label = section.settings.count_1
                    endcase
                    assign bar = count | times: 100.0 | divided_by: count_sum
                  -%}
                  <tr class="cb-rw__dist-row" data-rw-rating="{{ stars }}" role="button" tabindex="0" aria-pressed="false" aria-label="{{ stars }} stars, {{ label }} reviews">
                    <td class="cb-rw__dist-stars">
                      <span class="cb-rw__stars cb-rw__stars--dist" aria-hidden="true">
                        {%- for i in (1..5) -%}
                          {%- if i <= stars -%}
                            {%- render 'cb-review-star', fill: true -%}
                          {%- else -%}
                            {%- render 'cb-review-star', fill: false -%}
                          {%- endif -%}
                        {%- endfor -%}
                      </span>
                    </td>
                    <td class="cb-rw__dist-bar">
                      <div class="cb-rw__progress"><div style="width: {{ bar }}%;"></div></div>
                    </td>
                    <td class="cb-rw__dist-count">({{ label }})</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>

          <div class="cb-rw__menu">
            <button
              type="button"
              class="cb-rw__menu-button"
              aria-label="Sort reviews"
              aria-expanded="false"
              aria-controls="CbRwSort-{{ section.id }}"
              data-rw-toggle
            >
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
                <path d="M1.7 4.2h3.4M9.9 4.2h8.4M1.7 10h8.4M14.9 10h3.4M1.7 15.8h3.4M9.9 15.8h8.4"/>
                <circle cx="7.5" cy="4.2" r="2.2"/><circle cx="12.5" cy="10" r="2.2"/><circle cx="7.5" cy="15.8" r="2.2"/>
              </svg>
            </button>
            <ul class="cb-rw__dropdown cb-rw__sort" id="CbRwSort-{{ section.id }}" hidden>
              <li class="cb-rw__sort-title" aria-hidden="true">Sort by</li>
              {%- assign sorts = 'featured:Featured,newest:Newest,highest:Highest Ratings,lowest:Lowest Ratings' | split: ',' -%}
              {%- for sort in sorts -%}
                {%- assign pair = sort | split: ':' -%}
                <li>
                  <button type="button" data-rw-sort="{{ pair[0] }}" aria-pressed="{% if pair[0] == 'newest' %}true{% else %}false{% endif %}">
                    <span>{{ pair[1] }}</span>
                    <svg width="17" height="13" viewBox="0 0 17 13" fill="none" aria-hidden="true" focusable="false"><path d="m1 5.8 5.4 5.4L16.3 1.3" stroke="currentColor" stroke-width="2"/></svg>
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </div>

        <div class="cb-rw__grid" data-rw-grid>
          {%- for block in section.blocks -%}
            {%- liquid
              assign rating = block.settings.rating | default: 5
              assign media = block.settings.media
              assign video = block.settings.video
              assign video_src = ''
              if media == 'video' and video != blank
                assign sources = video.sources | where: 'mime_type', 'video/mp4' | sort: 'height'
                for source in sources
                  assign video_src = source.url
                  if source.height >= 720
                    break
                  endif
                endfor
              endif
              assign ratio = block.settings.media_ratio
              if media == 'photo' and block.settings.image != blank
                assign ratio = 100.0 | divided_by: block.settings.image.aspect_ratio
              elsif media == 'video' and video != blank
                assign ratio = 100.0 | divided_by: video.aspect_ratio
              endif
            -%}
            <div
              class="cb-rw__item"
              data-rw-item
              data-rating="{{ rating }}"
              data-date="{{ block.settings.date | escape }}"
              {% if forloop.index > section.settings.initial_count %}
                hidden
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <article class="cb-rw__card">
                {%- if media == 'photo' or media == 'video' -%}
                  <div class="cb-rw__media{% if media == 'video' %} cb-rw__media--video{% endif %}" style="padding-bottom: {{ ratio }}%;">
                    {%- if video_src != blank -%}
                      <video
                        class="cb-rw__video"
                        src="{{ video_src }}"
                        preload="none"
                        playsinline
                        {% if video.preview_image %}
                          poster="{{ video.preview_image | image_url: width: 600 }}"
                        {% endif %}
                      ></video>
                    {%- elsif media == 'photo' and block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 600
                        | image_tag: loading: 'lazy', sizes: '(min-width: 1150px) 20vw, (min-width: 750px) 33vw, 50vw', widths: '300, 450, 600', alt: block.settings.image.alt
                      }}
                    {%- else -%}
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                    {%- if media == 'video' -%}
                      <button type="button" class="cb-rw__play" aria-label="Play video" data-rw-play {% if video_src == blank %}disabled{% endif %}>
                        <svg viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false"><circle cx="32" cy="32" r="29.5" stroke="currentColor" stroke-width="3"/><path d="M26 21.5v21l17-10.5-17-10.5Z" fill="currentColor"/></svg>
                      </button>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                <div class="cb-rw__box">
                  <div class="cb-rw__name">
                    {{- block.settings.name | escape -}}
                    {%- if block.settings.verified -%}
                      <span class="cb-rw__verified">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" fill="currentColor"/><path d="m7.6 12.3 3 3 5.8-6" fill="none" stroke="#fff" stroke-width="2"/></svg>
                        <span>Verified</span>
                      </span>
                    {%- endif -%}
                  </div>
                  {%- if block.settings.date != blank -%}
                    <div class="cb-rw__date">{{ block.settings.date | escape }}</div>
                  {%- endif -%}
                  <div class="cb-rw__rating" role="img" aria-label="{{ rating }} out of 5 stars">
                    <span class="cb-rw__stars" aria-hidden="true">
                      {%- for i in (1..5) -%}
                        {%- if i <= rating -%}
                          {%- render 'cb-review-star', fill: true -%}
                        {%- else -%}
                          {%- render 'cb-review-star', fill: false -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </span>
                  </div>
                  {%- if block.settings.text != blank -%}
                    <div class="cb-rw__text-block"><div class="cb-rw__text">{{ block.settings.text | escape }}</div></div>
                  {%- endif -%}
                </div>

                {%- liquid
                  assign product = block.settings.product
                  assign product_title = block.settings.product_title
                  assign product_image = block.settings.product_image
                  if product != blank
                    assign product_title = product.title
                    assign product_image = product.featured_image
                  endif
                -%}
                {%- if product_title != blank -%}
                  <div class="cb-rw__product">
                    {%- if product != blank -%}<a class="cb-rw__product-link" href="{{ product.url }}">{%- endif -%}
                    <span class="cb-rw__product-image">
                      {%- if product_image != blank -%}
                        {{ product_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: product_title }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                    </span>
                    <span class="cb-rw__product-name">{{ product_title }}</span>
                    {%- if product != blank -%}</a>{%- endif -%}
                  </div>
                {%- endif -%}
              </article>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.blocks.size > section.settings.initial_count -%}
          <div class="cb-rw__more">
            <button type="button" class="cb-rw__more-button" data-rw-more>{{ section.settings.more_label }}</button>
          </div>
        {%- endif -%}
      </cb-reviews-wall>

      {%- if section.settings.text != blank -%}
        <div class="cb-reviews-wall__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reviews wall",
  "tag": "section",
  "class": "cb-section-wrapper",
  "max_blocks": 50,
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Customer A." },
        { "type": "checkbox", "id": "verified", "label": "Show \"Verified\"", "default": true },
        { "type": "text", "id": "date", "label": "Date", "info": "As shown, e.g. 11/25/2026 (used to sort by newest)", "default": "11/25/2026" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review", "default": "Beautiful abaya, great quality." },
        { "type": "header", "content": "Product" },
        { "type": "product", "id": "product", "label": "Product", "info": "Uses its title, picture and link" },
        { "type": "text", "id": "product_title", "label": "Product name", "info": "Used when no product is picked" },
        { "type": "image_picker", "id": "product_image", "label": "Product picture", "info": "Used when no product is picked" },
        { "type": "header", "content": "Photo or video" },
        {
          "type": "select",
          "id": "media",
          "label": "Media",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "photo", "label": "Photo" },
            { "value": "video", "label": "Video" }
          ],
          "default": "none"
        },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "video", "id": "video", "label": "Video" },
        {
          "type": "range",
          "id": "media_ratio",
          "label": "Dummy height",
          "info": "Height as a % of the width, until a photo or video is picked",
          "min": 50,
          "max": 250,
          "step": 1,
          "unit": "%",
          "default": 133
        }
      ]
    }
  ],
  "settings": [
    { "type": "checkbox", "id": "show_heading", "label": "Show heading", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title" },
    { "type": "header", "content": "Rating summary" },
    { "type": "text", "id": "average", "label": "Average rating", "default": "4.8" },
    { "type": "text", "id": "total_count", "label": "Number of reviews", "default": "6,201" },
    { "type": "text", "id": "reviews_label", "label": "Reviews label", "default": "Reviews" },
    { "type": "text", "id": "count_5", "label": "5 star reviews", "default": "5,349" },
    { "type": "text", "id": "count_4", "label": "4 star reviews", "default": "727" },
    { "type": "text", "id": "count_3", "label": "3 star reviews", "default": "77" },
    { "type": "text", "id": "count_2", "label": "2 star reviews", "default": "19" },
    { "type": "text", "id": "count_1", "label": "1 star reviews", "default": "29" },
    { "type": "header", "content": "Show more" },
    { "type": "range", "id": "initial_count", "label": "Reviews shown first", "min": 4, "max": 50, "step": 1, "default": 20 },
    { "type": "range", "id": "more_count", "label": "Reviews added per click", "min": 4, "max": 50, "step": 1, "default": 20 },
    { "type": "text", "id": "more_label", "label": "Button label", "default": "Show more reviews" },
    { "type": "header", "content": "Text under the reviews" },
    { "type": "richtext", "id": "text" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 60 }
  ],
  "presets": [
    {
      "name": "Reviews wall",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" }]
    }
  ]
}
{% endschema %}
