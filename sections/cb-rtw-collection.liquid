{%- doc -%}
  Ready to Wear collection grid, as on the live store: centred title and description (clamped,
  "Read More"), "By colour" chips (tag pages such as /collections/ready-to-wear-abayas/black),
  a sticky bar with breadcrumbs, sort and product count, filter accordions on the left
  (Size, Length (in), Length, Price, Availability, then everything else under "More filters"),
  four 2:3 product cards per row, and more products loading as you scroll.
{%- enddoc -%}

{{ 'cb-rtw-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cb-rtw-collection.js' | asset_url }}" defer></script>

{%- liquid
  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign opts_limit = section.settings.options_limit | default: 10
  assign active_tag = ''
  if current_tags
    assign active_tag = current_tags.first | downcase
  endif
  assign base_url = collection.url
  if active_tag != blank
    assign base_url = collection.url | append: '/' | append: active_tag
  endif
-%}

<section
  class="cb-section cb-rtw{% unless section.settings.show_filters %} cb-rtw--no-filters{% endunless %}"
  data-rtw
  data-section-id="{{ section.id }}"
  data-base-url="{{ base_url }}"
  style="{% render 'cb-section-style', settings: section.settings %} --cb-rtw-cols: {{ section.settings.columns_desktop }}; --cb-rtw-cols-tablet: {{ section.settings.columns_tablet | default: 3 }}; --cb-rtw-cols-mobile: {{ section.settings.columns_mobile }};"
>
  <div class="cb-rtw__header">
    <h1 class="cb-rtw__title">{{ section.settings.heading | default: collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="cb-rtw__desc-wrap">
        <div class="cb-rtw__desc" data-rtw-desc>{{ collection.description }}</div>
        <button
          type="button"
          class="cb-rtw__read-more"
          data-rtw-read-more
          data-more-label="{{ section.settings.read_more_label | default: 'Read More' | escape }}"
          data-less-label="{{ section.settings.read_less_label | default: 'Read Less' | escape }}"
          aria-expanded="false"
        >
          {{- section.settings.read_more_label | default: 'Read More' -}}
        </button>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_colour_row and section.blocks.size > 0 -%}
    <div class="cb-rtw__colours">
      <div class="cb-rtw__colours-inner">
        <span class="cb-rtw__colours-label">{{ section.settings.colour_heading | default: 'By colour' }}</span>
        <nav aria-label="{{ section.settings.colour_heading | default: 'By colour' | escape }}">
          <ul class="cb-rtw__colours-list" role="list">
            {%- assign any_colour_active = false -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'colour_chip' -%}
                {%- liquid
                  assign chip_val = block.settings.value | default: block.settings.label
                  assign chip_handle = chip_val | handleize
                  assign is_chip_active = false
                  if active_tag == chip_handle
                    assign is_chip_active = true
                    assign any_colour_active = true
                  endif
                -%}
                <li>
                  <a
                    class="cb-rtw__chip{% if is_chip_active %} is-active{% endif %}"
                    href="{{ collection.url }}/{{ chip_handle }}"
                    {% if is_chip_active %}aria-current="true"{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.color != blank -%}
                      <span class="cb-rtw__chip-dot" style="background-color: {{ block.settings.color }};" aria-hidden="true"></span>
                    {%- endif -%}
                    <span>{{ block.settings.label }}</span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
            <li>
              <a class="cb-rtw__chip{% unless any_colour_active %} is-active{% endunless %}" href="{{ collection.url }}"{% unless any_colour_active %} aria-current="true"{% endunless %}>
                {{- section.settings.all_colours_label | default: 'All colours' -}}
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  {%- endif -%}

  <div class="cb-rtw__body">
    <div class="cb-rtw__bar">
      <nav class="cb-rtw__crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a><span class="cb-rtw__crumb-sep" aria-hidden="true">/</span>
        <a href="{{ routes.collections_url }}">Collections</a>
        <span class="cb-rtw__crumb-sep" aria-hidden="true">/</span><span class="cb-rtw__crumb-current">{{ collection.title }}</span>
      </nav>

      {%- comment -%} On phones this opens the filters (or, with filters off, just the sorting) {%- endcomment -%}
      <button type="button" class="cb-rtw__filter-toggle" data-rtw-drawer-open aria-controls="CbRtwFilters-{{ section.id }}" aria-label="Filters">
          <svg viewBox="0 0 20 13" aria-hidden="true" focusable="false"><path d="M18.5 2.75a.75.75 0 0 1 .1 1.5h-17a.75.75 0 0 1-.1-1.5h17Zm0 6a.75.75 0 0 1 .1 1.5h-17a.75.75 0 0 1-.1-1.5h17Z"/><path d="M5.5.25a.75.75 0 0 1 .75.75v5a.75.75 0 0 1-1.5 0V1a.75.75 0 0 1 .75-.75Zm9 6a.75.75 0 0 1 .75.75v5a.75.75 0 0 1-1.5 0V7a.75.75 0 0 1 .75-.75Z"/></svg>
        </button>

      {%- if collection.sort_options.size > 0 -%}
        <div class="cb-rtw__sort" data-rtw-sort>
          <button type="button" class="cb-rtw__sort-toggle" aria-expanded="false" data-rtw-sort-toggle>
            Sort by
            <svg viewBox="0 0 192 192" aria-hidden="true" focusable="false"><path d="m72 36 60 60-60 60" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="cb-rtw__sort-panel" hidden data-rtw-sort-panel>
            <ul class="cb-rtw__sort-list" role="list">
              {%- for option in collection.sort_options -%}
                <li>
                  <label class="cb-rtw__sort-option">
                    <input type="radio" name="sort_by" value="{{ option.value }}" {% if option.value == current_sort %}checked{% endif %} data-rtw-sort-input>
                    <span>{{ option.name }}</span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- endif -%}

      <span class="cb-rtw__count" role="status" data-rtw-count>{{ collection.products_count }} products</span>
    </div>

    <div class="cb-rtw__layout{% unless section.settings.show_filters %} is-no-sidebar{% endunless %}">
        <aside class="cb-rtw__sidebar" id="CbRtwFilters-{{ section.id }}" aria-label="Filters" data-rtw-sidebar>
          <div class="cb-rtw__drawer-head">
            <button type="button" class="cb-rtw__drawer-close" data-rtw-drawer-close aria-label="Close filters">
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m3.5 3.5 9 9m0-9-9 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
            <div class="cb-rtw__drawer-title">Filters</div>
            <hr class="cb-rtw__drawer-line">
          </div>
          <form class="cb-rtw__form" data-rtw-form>
            {%- if collection.sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}" data-rtw-sort-hidden>{%- endif -%}

            {%- comment -%} Phones: sorting sits at the top of the filters (the radios belong to no form, so they never end up in the filter URL) {%- endcomment -%}
            {%- if collection.sort_options.size > 0 -%}
              <div class="cb-rtw__filter cb-rtw__filter--sort" data-rtw-filter="sort-by">
                <button type="button" class="cb-rtw__filter-title" aria-expanded="false" data-rtw-filter-toggle>
                  <span>Sort by</span>
                  {%- render 'cb-rtw-toggle-icon' -%}
                </button>
                <div class="cb-rtw__filter-panel" hidden>
                  <ul class="cb-rtw__options cb-rtw__options--sort" role="list">
                    {%- for option in collection.sort_options -%}
                      <li>
                        <label class="cb-rtw__sort-option">
                          <input type="radio" name="sort_by_drawer" form="CbRtwSortDrawer-{{ section.id }}" value="{{ option.value }}" {% if option.value == current_sort %}checked{% endif %} data-rtw-sort-input>
                          <span>{{ option.name }}</span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            {%- endif -%}

            {%- if section.settings.show_filters -%}
            {%- capture more_items -%}
              {%- assign more_count = 0 -%}
              {%- for filter in collection.filters -%}
                {%- assign f_key = filter.label | downcase | strip -%}
                {%- unless f_key == 'size' or f_key == 'length (in)' or f_key == 'length' or f_key == 'price' or f_key == 'availability' or f_key == 'colour' or f_key == 'color' or filter.type == 'price_range' -%}
                  {%- for value in filter.values -%}
                    {%- assign more_count = more_count | plus: 1 -%}
                    {%- render 'cb-rtw-filter-option', value: value, extra: more_count, limit: opts_limit -%}
                  {%- endfor -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- endcapture -%}

            {%- assign ordered_keys = 'size|length (in)|length|price|availability' | split: '|' -%}
            {%- for target_key in ordered_keys -%}
              {%- for filter in collection.filters -%}
                {%- assign f_key = filter.label | downcase | strip -%}
                {%- if f_key == target_key -%}
                  {%- assign is_open = false -%}
                  {%- assign default_open = false -%}
                  {%- if filter.active_values.size > 0 -%}{%- assign is_open = true -%}{%- endif -%}
                  {%- if filter.type == 'price_range' -%}{%- if filter.min_value.value != nil or filter.max_value.value != nil -%}{%- assign is_open = true -%}{%- endif -%}{%- endif -%}
                  {%- if f_key == 'size' and is_open == false -%}{%- assign is_open = true -%}{%- assign default_open = true -%}{%- endif -%}
                  <div class="cb-rtw__filter{% if is_open %} is-open{% endif %}" data-rtw-filter="{{ f_key | handleize }}"{% if default_open %} data-rtw-default-open{% endif %}>
                    <button type="button" class="cb-rtw__filter-title" aria-expanded="{{ is_open }}" data-rtw-filter-toggle>
                      <span>{{ filter.label }}</span>
                      {%- render 'cb-rtw-toggle-icon' -%}
                    </button>
                    <div class="cb-rtw__filter-panel" {% unless is_open %}hidden{% endunless %}>
                      {%- if filter.type == 'price_range' -%}
                        {%- liquid
                          assign range_max = filter.range_max | divided_by: 100.0 | ceil
                          assign min_val = ''
                          assign max_val = ''
                          if filter.min_value.value != nil
                            assign min_val = filter.min_value.value | divided_by: 100.0 | round
                          endif
                          if filter.max_value.value != nil
                            assign max_val = filter.max_value.value | divided_by: 100.0 | round
                          endif
                        -%}
                        <div class="cb-rtw__price" data-rtw-price data-max="{{ range_max }}">
                          <div class="cb-rtw__range">
                            <div class="cb-rtw__range-line"><span data-rtw-range-fill></span></div>
                            <input type="range" class="cb-rtw__range-input" min="0" max="{{ range_max }}" step="1" value="{{ min_val | default: 0 }}" aria-label="Minimum price" data-rtw-range-min>
                            <input type="range" class="cb-rtw__range-input" min="0" max="{{ range_max }}" step="1" value="{{ max_val | default: range_max }}" aria-label="Maximum price" data-rtw-range-max>
                          </div>
                          <div class="cb-rtw__price-fields">
                            <label class="cb-rtw__price-field">
                              <span class="cb-rtw__price-symbol">{{ cart.currency.symbol | default: 'د.إ' }}</span>
                              <input class="cb-rtw__price-input" type="number" inputmode="numeric" name="{{ filter.min_value.param_name }}" placeholder="0" min="0" max="{{ range_max }}" value="{{ min_val }}" aria-label="From" data-rtw-price-min>
                            </label>
                            <label class="cb-rtw__price-field">
                              <span class="cb-rtw__price-symbol">{{ cart.currency.symbol | default: 'د.إ' }}</span>
                              <input class="cb-rtw__price-input" type="number" inputmode="numeric" name="{{ filter.max_value.param_name }}" placeholder="{{ range_max }}" min="0" max="{{ range_max }}" value="{{ max_val }}" aria-label="To" data-rtw-price-max>
                            </label>
                          </div>
                        </div>
                      {%- else -%}
                        <ul class="cb-rtw__options" role="list">
                          {%- for value in filter.values -%}
                            {%- render 'cb-rtw-filter-option', value: value, extra: forloop.index, limit: opts_limit -%}
                          {%- endfor -%}
                        </ul>
                        {%- if filter.values.size > opts_limit -%}
                          <button type="button" class="cb-rtw__show-more" aria-expanded="false" data-rtw-show-more>
                            <span>Show more</span><span>Show less</span>
                          </button>
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}

            {%- if more_count > 0 -%}
              <div class="cb-rtw__filter" data-rtw-filter="more-filters">
                <button type="button" class="cb-rtw__filter-title" aria-expanded="false" data-rtw-filter-toggle>
                  <span>More filters</span>
                  {%- render 'cb-rtw-toggle-icon' -%}
                </button>
                <div class="cb-rtw__filter-panel" hidden>
                  <ul class="cb-rtw__options" role="list">{{ more_items }}</ul>
                  {%- if more_count > opts_limit -%}
                    <button type="button" class="cb-rtw__show-more" aria-expanded="false" data-rtw-show-more>
                      <span>Show more</span><span>Show less</span>
                    </button>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
            {%- endif -%}
          </form>
        </aside>

      <div class="cb-rtw__results" data-rtw-results>
        {%- paginate collection.products by section.settings.products_per_page -%}
          {%- if collection.products.size > 0 -%}
            <ul class="cb-rtw__grid" role="list" data-rtw-grid>
              {%- for product in collection.products -%}
                <li class="cb-rtw__card">
                  <div class="cb-rtw__card-media">
                    <a class="cb-rtw__card-link" href="{{ product.url | within: collection }}" aria-label="{{ product.title | escape }}">
                      {%- if product.featured_media != blank -%}
                        {{
                          product.featured_media
                          | image_url: width: 900
                          | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(max-width: 479px) 46vw, (max-width: 1023px) 31vw, 22vw', alt: product.title, class: 'cb-rtw__card-img'
                        }}
                        {%- assign second = product.media[1] -%}
                        {%- if second != blank -%}
                          {{
                            second
                            | image_url: width: 900
                            | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(max-width: 479px) 46vw, (max-width: 1023px) 31vw, 22vw', alt: '', class: 'cb-rtw__card-img cb-rtw__card-img--hover'
                          }}
                        {%- endif -%}
                      {%- else -%}
                        {%- assign ph_idx = forloop.index0 | modulo: 4 | plus: 1 -%}
                        {{ 'product-apparel-' | append: ph_idx | placeholder_svg_tag: 'placeholder-svg cb-rtw__card-img' }}
                      {%- endif -%}
                    </a>
                    {%- render 'quick-add', product: product, section_id: section.id -%}
                  </div>
                  <div class="cb-rtw__card-info">
                    <a class="cb-rtw__card-title" href="{{ product.url | within: collection }}">{{ product.title }}</a>
                    <a class="cb-rtw__card-price" href="{{ product.url | within: collection }}">{{ product.price | money }}</a>
                  </div>
                </li>
              {%- endfor -%}
            </ul>

            {%- if paginate.next -%}
              <div class="cb-rtw__loader" data-rtw-next="{{ paginate.next.url }}">
                <a class="cb-rtw__loader-link" href="{{ paginate.next.url }}">Loading</a>
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="cb-rtw__empty">
              <p>No products found.</p>
              <a class="cb-rtw__clear" href="{{ collection.url }}">Clear all</a>
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </div>
  <div class="cb-rtw__overlay" data-rtw-drawer-close hidden></div>
</section>

{% schema %}
{
  "name": "RTW Collection Grid",
  "tag": "section",
  "blocks": [
    {
      "type": "colour_chip",
      "name": "Colour chip",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Black" },
        { "type": "text", "id": "value", "label": "Tag", "info": "Opens the collection filtered by this tag. Defaults to the label" },
        { "type": "color", "id": "color", "label": "Dot color", "default": "#000000" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading override", "info": "Leave blank to use collection title" },
    { "type": "text", "id": "read_more_label", "label": "Read more label", "default": "Read More" },
    { "type": "text", "id": "read_less_label", "label": "Read less label", "default": "Read Less" },
    { "type": "header", "content": "BY COLOUR row" },
    { "type": "checkbox", "id": "show_colour_row", "label": "Show BY COLOUR row", "default": true },
    { "type": "text", "id": "colour_heading", "label": "Colour row label", "default": "By colour" },
    { "type": "text", "id": "all_colours_label", "label": "All colours label", "default": "All colours" },
    { "type": "header", "content": "Filters & Grid" },
    { "type": "checkbox", "id": "show_filters", "label": "Show sidebar filters", "default": true },
    { "type": "range", "id": "options_limit", "label": "Options before Show more", "min": 4, "max": 24, "step": 1, "default": 10 },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_tablet", "label": "Tablet columns", "info": "Screens from 480px to 1023px wide", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "columns_mobile", "label": "Mobile columns", "info": "Screens under 480px wide", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }], "default": "2" },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 20 },
    { "type": "header", "content": "Colors & Padding" },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 30 }
  ],
  "presets": [
    {
      "name": "RTW Collection Grid"
    }
  ]
}
{% endschema %}
