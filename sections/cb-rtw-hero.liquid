{{ 'cb-rtw-collection.css' | asset_url | stylesheet_tag }}

<section
  class="cb-section cb-rtw-hero"
  style="--cb-rtw-hero-bg: {{ section.settings.background_color | default: '#fcfaf6' }}; --cb-pt: {{ section.settings.padding_top }}px; --cb-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="cb-rtw-hero__inner">
    <div class="cb-rtw-hero__side">
      {%- for i in (1..3) -%}
        {%- assign key = 'left_image_' | append: i -%}
        {%- assign img = section.settings[key] -%}
        <div class="cb-rtw-hero__slot">
          {%- if img != blank -%}
            {{ img | image_url: width: 600 | image_tag: loading: 'eager', widths: '300, 600', sizes: '(max-width: 1024px) 33vw, 180px', alt: img.alt | default: section.settings.heading }}
          {%- else -%}
            {{ 'product-apparel-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="cb-rtw-hero__center">
      {%- if section.settings.heading != blank -%}
        <h1 class="cb-rtw-hero__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="cb-rtw-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="cb-rtw-hero__side">
      {%- for i in (1..3) -%}
        {%- assign key = 'right_image_' | append: i -%}
        {%- assign img = section.settings[key] -%}
        <div class="cb-rtw-hero__slot">
          {%- if img != blank -%}
            {{ img | image_url: width: 600 | image_tag: loading: 'eager', widths: '300, 600', sizes: '(max-width: 1024px) 33vw, 180px', alt: img.alt | default: section.settings.heading }}
          {%- else -%}
            {%- assign svg_idx = i | plus: 1 -%}
            {%- if svg_idx > 4 -%}{%- assign svg_idx = 1 -%}{%- endif -%}
            {{ 'product-apparel-' | append: svg_idx | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RTW Hero Banner",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Wear Abayas"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Notice & details",
      "default": "<p>Delivery in 1-2 Business Days</p><p>Fast Delivery | No customizations | No alterations | No refunds | No exchanges</p><p><strong>NO REFUNDS OR EXCHANGES ON READY TO WEAR ABAYAS AT CAS ABAYA OUTLET</strong></p><p>Use code <strong>RTW40</strong> for 40% Off</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fcfaf6"
    },
    {
      "type": "header",
      "content": "Left side images (3 slots)"
    },
    { "type": "image_picker", "id": "left_image_1", "label": "Left image 1" },
    { "type": "image_picker", "id": "left_image_2", "label": "Left image 2" },
    { "type": "image_picker", "id": "left_image_3", "label": "Left image 3" },
    {
      "type": "header",
      "content": "Right side images (3 slots)"
    },
    { "type": "image_picker", "id": "right_image_1", "label": "Right image 1" },
    { "type": "image_picker", "id": "right_image_2", "label": "Right image 2" },
    { "type": "image_picker", "id": "right_image_3", "label": "Right image 3" },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "RTW Hero Banner"
    }
  ]
}
{% endschema %}
