{%- doc -%}
  Ready to Wear banner, as on the live store: 450px tall, three models on the left and three
  on the right, the title and the collection's notes centred between them.
  The picture is the "Wide banner picture" if one is chosen, otherwise the collection's own
  image (what the live store shows), otherwise six single pictures. Pictures are cropped like
  the live banner (a 3.97:1 artwork covering the band). Empty slots show a dummy.
{%- enddoc -%}

{{ 'cb-rtw-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign text = section.settings.text
  if section.settings.use_collection_text and collection.description != blank
    assign text = collection.description
  endif
  assign heading = section.settings.heading | default: collection.title
  assign banner = section.settings.banner_image
  if banner == blank and section.settings.use_collection_image and collection.image != blank
    assign banner = collection.image
  endif
-%}

<section
  class="cb-rtw-hero"
  style="--cb-rtw-hero-bg: {{ section.settings.background_color | default: '#fcfaf6' }}; --cb-rtw-hero-h: {{ section.settings.height }}px; --cb-pt: {{ section.settings.padding_top }}px; --cb-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="cb-rtw-hero__band">
    <div class="cb-rtw-hero__art" aria-hidden="true">
      {%- if banner != blank -%}
        {{
          banner
          | image_url: width: 3000
          | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800, 1200, 1600, 2000, 2400, 3000', sizes: '(min-width: 1134px) 100vw, 1787px', alt: '', class: 'cb-rtw-hero__banner'
        }}
      {%- else -%}
        {%- for side in (1..2) -%}
          {%- if side == 1 -%}{%- assign side_name = 'left' -%}{%- else -%}{%- assign side_name = 'right' -%}{%- endif -%}
          <div class="cb-rtw-hero__side cb-rtw-hero__side--{{ side_name }}">
            {%- for i in (1..3) -%}
              {%- assign key = side_name | append: '_image_' | append: i -%}
              {%- assign img = section.settings[key] -%}
              <div class="cb-rtw-hero__slot">
                {%- if img != blank -%}
                  {{ img | image_url: width: 600 | image_tag: loading: 'eager', widths: '300, 450, 600', sizes: '(min-width: 1024px) 9vw, 30vw', alt: '' }}
                {%- else -%}
                  {%- assign ph = i | plus: side | modulo: 4 | plus: 1 -%}
                  {{ 'product-apparel-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="cb-rtw-hero__content">
      <div class="cb-rtw-hero__text">
        {%- if heading != blank -%}
          <h1 class="cb-rtw-hero__title">{{ heading }}</h1>
        {%- endif -%}
        {%- if text != blank -%}
          <div class="cb-rtw-hero__notes">{{ text }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RTW Hero Banner",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the collection title", "default": "Ready to Wear Abayas" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Notice & details",
      "default": "<p><strong>Delivery in 1-2 Business Days</strong></p><p>Fast Delivery | No customizations | No alterations | No refunds | No exchanges</p><p><strong>NO REFUNDS OR EXCHANGES ON READY TO WEAR ABAYAS AT CAS ABAYA OUTLET</strong></p><p>Use code <strong>RTW40</strong> for 40% Off</p>"
    },
    { "type": "checkbox", "id": "use_collection_text", "label": "Use the collection description instead", "default": false },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#fcfaf6" },
    { "type": "range", "id": "height", "label": "Height", "min": 300, "max": 700, "step": 10, "unit": "px", "default": 450 },
    { "type": "header", "content": "Banner picture" },
    { "type": "image_picker", "id": "banner_image", "label": "Wide banner picture", "info": "One picture with the models on both sides. Leave empty to use the collection image" },
    { "type": "checkbox", "id": "use_collection_image", "label": "Use the collection image when no banner is chosen", "info": "The live store shows the collection's own image here. Turn off to use the six pictures below", "default": true },
    { "type": "header", "content": "Left side images (3 slots)" },
    { "type": "image_picker", "id": "left_image_1", "label": "Left image 1" },
    { "type": "image_picker", "id": "left_image_2", "label": "Left image 2" },
    { "type": "image_picker", "id": "left_image_3", "label": "Left image 3" },
    { "type": "header", "content": "Right side images (3 slots)" },
    { "type": "image_picker", "id": "right_image_1", "label": "Right image 1" },
    { "type": "image_picker", "id": "right_image_2", "label": "Right image 2" },
    { "type": "image_picker", "id": "right_image_3", "label": "Right image 3" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "RTW Hero Banner"
    }
  ]
}
{% endschema %}
