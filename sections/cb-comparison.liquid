<div
  class="cb-section cb-compare"
  style="{% render 'cb-section-style', settings: section.settings %}"
>
  <div class="cb-container">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="cb-compare__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="cb-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="cb-rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cb-compare__table" role="table" aria-label="{{ section.settings.heading | escape }}">
      <div class="cb-compare__row cb-compare__row--head" role="row">
        <span class="cb-compare__cell cb-compare__cell--us" role="columnheader">{{ section.settings.us_label }}</span>
        <span class="cb-compare__cell cb-compare__cell--them" role="columnheader">{{ section.settings.them_label }}</span>
      </div>
      {%- for block in section.blocks -%}
        <div class="cb-compare__row" role="row" {{ block.shopify_attributes }}>
          <span class="cb-compare__cell cb-compare__cell--us" role="cell">
            {%- render 'cb-icon', icon: 'check', class: 'cb-compare__mark' -%}
            <span>{{ block.settings.us }}</span>
          </span>
          <span class="cb-compare__cell cb-compare__cell--them" role="cell">
            {%- render 'cb-icon', icon: 'cross', class: 'cb-compare__mark' -%}
            <span>{{ block.settings.them }}</span>
          </span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparison",
  "tag": "section",
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "us", "label": "Our brand", "default": "Made to your measurements at no extra cost" },
        { "type": "text", "id": "them", "label": "Others", "default": "Customisation charged as an extra" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why choose us" },
    { "type": "richtext", "id": "text", "label": "Subheading", "default": "<p>What sets us apart</p>" },
    { "type": "text", "id": "us_label", "label": "Our column label", "default": "Us" },
    { "type": "text", "id": "them_label", "label": "Other column label", "default": "Others" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 60 }
  ],
  "presets": [
    {
      "name": "Comparison",
      "blocks": [
        { "type": "row" },
        { "type": "row", "settings": { "us": "Fine fabrics chosen piece by piece", "them": "Mass-produced fabrics" } },
        { "type": "row", "settings": { "us": "Personal support from our stylists", "them": "Little help once you've paid" } }
      ]
    }
  ]
}
{% endschema %}
