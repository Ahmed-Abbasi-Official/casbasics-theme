{%- assign classic = false -%}
{%- if section.settings.style == 'classic' -%}{%- assign classic = true -%}{%- endif -%}
{%- if section.settings.style == 'cards' -%}
  {%- comment -%} Two lists in a white card, ticks for us and crosses for others (live store About page) {%- endcomment -%}
  <div
    class="cb-section cb-compare-cards"
    style="{% render 'cb-section-style', settings: section.settings %}"
  >
    <div class="cb-compare-cards__container">
      {%- if section.settings.heading != blank or section.settings.text != blank -%}
        <div class="cb-compare-cards__head">
          {%- if section.settings.heading != blank -%}
            <h2 class="cb-compare-cards__title">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="cb-compare-cards__subtitle">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="cb-compare-cards__grid">
        <div class="cb-compare-cards__col cb-compare-cards__col--us">
          <h3 class="cb-compare-cards__label">{{ section.settings.us_label }}</h3>
          <ul class="cb-compare-cards__list" role="list">
            {%- for block in section.blocks -%}
              {%- if block.settings.us != blank -%}
                <li class="cb-compare-cards__item" {{ block.shopify_attributes }}>
                  <span class="cb-compare-cards__icon" aria-hidden="true">✓</span>
                  <span class="cb-compare-cards__text">{{ block.settings.us }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
        <div class="cb-compare-cards__divider" aria-hidden="true"></div>
        <div class="cb-compare-cards__col cb-compare-cards__col--them">
          <h3 class="cb-compare-cards__label">{{ section.settings.them_label }}</h3>
          <ul class="cb-compare-cards__list" role="list">
            {%- for block in section.blocks -%}
              {%- if block.settings.them != blank -%}
                <li class="cb-compare-cards__item">
                  <span class="cb-compare-cards__icon" aria-hidden="true">✕</span>
                  <span class="cb-compare-cards__text">{{ block.settings.them }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  </div>
{%- else -%}
<div
  class="cb-section cb-compare{% if classic %} cb-compare--classic{% endif %}"
  style="{% render 'cb-section-style', settings: section.settings %}"
>
  <div class="cb-container">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="cb-compare__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="cb-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="cb-rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cb-compare__table" role="table" aria-label="{{ section.settings.heading | escape }}">
      <div class="cb-compare__row cb-compare__row--head" role="row">
        <span class="cb-compare__cell cb-compare__cell--us" role="columnheader">{{ section.settings.us_label }}</span>
        <span class="cb-compare__cell cb-compare__cell--them" role="columnheader">{{ section.settings.them_label }}</span>
      </div>
      {%- for block in section.blocks -%}
        <div class="cb-compare__row" role="row" {{ block.shopify_attributes }}>
          <span class="cb-compare__cell cb-compare__cell--us" role="cell">
            {%- if classic -%}
              <svg class="cb-compare__mark" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false"><path d="m2.5 7.2 3 3 6-6.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- else -%}
              {%- render 'cb-icon', icon: 'check', class: 'cb-compare__mark' -%}
            {%- endif -%}
            <span>{{ block.settings.us }}</span>
          </span>
          <span class="cb-compare__cell cb-compare__cell--them" role="cell">
            {%- if classic -%}
              <svg class="cb-compare__mark" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false"><path d="m3.5 3.5 5 5m0-5-5 5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>
            {%- else -%}
              {%- render 'cb-icon', icon: 'cross', class: 'cb-compare__mark' -%}
            {%- endif -%}
            <span>{{ block.settings.them }}</span>
          </span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Comparison",
  "tag": "section",
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "us", "label": "Our brand", "default": "Made to your measurements at no extra cost" },
        { "type": "text", "id": "them", "label": "Others", "default": "Customisation charged as an extra" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why choose us" },
    { "type": "richtext", "id": "text", "label": "Subheading", "default": "<p>What sets us apart</p>" },
    { "type": "text", "id": "us_label", "label": "Our column label", "default": "Us" },
    { "type": "text", "id": "them_label", "label": "Other column label", "default": "Others" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "classic", "label": "Classic (760px rounded table)" },
        { "value": "cards", "label": "Two lists in a card (ticks and crosses)" }
      ],
      "default": "default"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 60 }
  ],
  "presets": [
    {
      "name": "Comparison",
      "blocks": [
        { "type": "row" },
        { "type": "row", "settings": { "us": "Fine fabrics chosen piece by piece", "them": "Mass-produced fabrics" } },
        { "type": "row", "settings": { "us": "Personal support from our stylists", "them": "Little help once you've paid" } }
      ]
    }
  ]
}
{% endschema %}
