{% comment %}
  Unified Quick Buy right-side drawer content for all products.
  Layout order: Title -> Price -> Image carousel -> Stock status -> Variants (+ Size Guide) ->
  FAQ link -> Description -> Sticky Add to Cart + View all details.
{% endcomment %}

{% liquid
  assign product_resource = product
  if product_resource == blank
    assign product_resource = closest.product
  endif
  assign current_variant = product_resource.selected_or_first_available_variant
  assign desc_text = product_resource.description | strip_html | strip
%}

<product-component
  class="cb-qd"
  data-product-grid-content
  data-quick-add-section-id="{{ section.id }}"
  {% unless product_resource.id == blank %}
    view-event-payload="{{ product_resource | standard_event_data: 'view' | escape }}"
  {% endunless %}
>
  <div class="cb-qd__body">
    <div class="cb-qd__head">
      <div class="view-product-title cb-qd__title">
        <a href="{{ current_variant.url | default: product_resource.url }}">
          {{- product_resource.title -}}
        </a>
      </div>
      <div class="cb-qd__price">
        {% content_for 'block', type: 'price', id: 'price', closest.product: product_resource %}
      </div>
    </div>

    {% if product_resource.media.size > 0 %}
      <div class="cb-qd__gallery" data-qd-gallery>
        <div class="cb-qd__track" data-qd-track>
          {% for media in product_resource.media %}
            <div class="cb-qd__slide">
              {{
                media
                | image_url: width: 900
                | image_tag:
                  loading: 'eager',
                  sizes: '360px',
                  widths: '360, 540, 720, 900',
                  alt: media.alt | default: product_resource.title
              }}
            </div>
          {% endfor %}
        </div>
        {% if product_resource.media.size > 1 %}
          <button type="button" class="cb-qd__arrow cb-qd__arrow--prev" data-qd-prev aria-label="Previous image">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="cb-qd__arrow cb-qd__arrow--next" data-qd-next aria-label="Next image">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {% endif %}
      </div>
    {% endif %}

    <div class="cb-qd__stock{% unless current_variant.available %} is-out{% endunless %}">
      <span class="cb-qd__stock-dot" aria-hidden="true"></span>
      <span>
        {%- if current_variant.available -%}
          Item is in stock
        {%- else -%}
          Out of stock
        {%- endif -%}
      </span>
    </div>

    <div class="cb-qd__variants">
      <a class="cb-qd__size-guide" href="/pages/size-chart" data-qd-size-guide>
        <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false"><rect x="26.2" y="82.7" width="203.6" height="90.5" rx="8" transform="rotate(-45 128 128)" fill="none" stroke="currentColor" stroke-width="16"/><path d="m132 60 32 32M96 96l32 32M60 132l32 32" stroke="currentColor" stroke-width="16"/></svg>
        <span>SIZE GUIDE</span>
      </a>
      {% content_for 'block', type: 'variant-picker', id: 'variant-picker', closest.product: product_resource %}
    </div>

    <p class="cb-qd__faq">
      Have some questions? Check out our <a href="/pages/faq">FAQ's</a>
    </p>

    {% if desc_text != blank %}
      <p class="cb-qd__desc">{{ desc_text | truncate: 220 }}</p>
    {% endif %}
  </div>

  <div class="cb-qd__foot">
    {% content_for 'block', type: 'buy-buttons', id: 'buy-buttons', closest.product: product_resource %}
    <a class="cb-qd__view-all" href="{{ product_resource.url }}">View all details</a>
  </div>
</product-component>

{% schema %}
{
  "name": "t:names.product_information",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": []
}
{% endschema %}
