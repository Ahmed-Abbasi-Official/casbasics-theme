{%- liquid
  assign box_style = ''
  if section.settings.box_color != blank and section.settings.box_color.alpha != 0
    assign box_style = '--cb-box-bg: ' | append: section.settings.box_color | append: ';'
  endif
-%}

<div
  class="cb-section cb-press cb-press--{{ section.settings.layout | default: 'card' }}{% if section.settings.rounded %} cb-press--rounded{% endif %}"
  style="{% render 'cb-section-style', settings: section.settings %}"
>
  <div class="cb-container">
    <cb-press
      class="cb-press__box"
      data-autoplay="{{ section.settings.autoplay }}"
      style="{{ box_style }} --cb-logo-h: {{ section.settings.logo_height }}px;"
    >
      {%- if section.settings.heading != blank -%}
        <span class="cb-subheading">{{ section.settings.heading }}</span>
      {%- endif -%}

      <div class="cb-press__slides" aria-live="polite">
        {%- for block in section.blocks -%}
          <figure
            class="cb-press__slide"
            data-press-slide
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            {{ block.shopify_attributes }}
          >
            <blockquote class="cb-press__quote">{{ block.settings.quote }}</blockquote>
            {%- if block.settings.source != blank -%}
              <figcaption class="cb-press__source">{{ block.settings.source }}</figcaption>
            {%- endif -%}
            {%- if block.settings.link != blank and block.settings.link_label != blank -%}
              <div class="cb-press__more">
                <a class="cb-text-link" href="{{ block.settings.link }}" target="_blank" rel="noopener">
                  {{- block.settings.link_label -}}
                </a>
              </div>
            {%- endif -%}
          </figure>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <ul class="cb-press__logos" role="list">
          {%- for block in section.blocks -%}
            {%- assign logo_label = block.settings.publication | default: block.settings.source | default: 'Press' -%}
            <li>
              <button
                type="button"
                class="cb-press__logo"
                data-press-logo
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ logo_label | escape }}"
              >
                {%- if block.settings.logo != blank -%}
                  {{ block.settings.logo | image_url: width: 300 | image_tag: loading: 'lazy', alt: logo_label }}
                {%- else -%}
                  {{ logo_label }}
                {%- endif -%}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </cb-press>
  </div>
</div>

{% schema %}
{
  "name": "Press",
  "tag": "section",
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Publication logo" },
        { "type": "text", "id": "publication", "label": "Publication name", "default": "Publication" },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>A brand redefining modern modest wear with timeless, handcrafted pieces.</p>"
        },
        { "type": "text", "id": "source", "label": "Source line", "default": "— Says Publication" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Read more" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured in" },
    { "type": "range", "id": "autoplay", "label": "Autoplay (seconds, 0 = off)", "min": 0, "max": 12, "step": 1, "default": 6 },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 16, "max": 64, "step": 2, "unit": "px", "default": 32 },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "card", "label": "Card" },
        { "value": "band", "label": "Full-width band, large heading" }
      ],
      "default": "card"
    },
    { "type": "checkbox", "id": "rounded", "label": "Rounded box", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "box_color", "label": "Box background", "default": "#e7e4e1" },
    { "type": "color", "id": "background_color", "label": "Section background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [
    {
      "name": "Press",
      "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }]
    }
  ]
}
{% endschema %}
