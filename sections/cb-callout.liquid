<div
  class="cb-section cb-callout-section"
  style="{% render 'cb-section-style', settings: section.settings %} --cb-accent: {{ section.settings.accent_color | default: '#6c0013' }}; --cb-box-bg: {{ section.settings.box_color | default: '#f8f7f5' }};"
>
  <div class="cb-container">
    <div class="cb-callout">
      {%- if section.settings.icon != 'none' -%}
        <span class="cb-callout__icon" aria-hidden="true">{%- render 'cb-icon', icon: section.settings.icon -%}</span>
      {%- endif -%}
      <div>
        {%- if section.settings.title != blank -%}
          <h2 class="cb-callout__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="cb-callout__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Callout card",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "users", "label": "People" },
        { "value": "heart", "label": "Heart" },
        { "value": "gift", "label": "Gift" },
        { "value": "star", "label": "Star" },
        { "value": "chat", "label": "Chat" }
      ],
      "default": "users"
    },
    { "type": "text", "id": "title", "label": "Title", "default": "Better with family & friends" },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Share a short note here" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "box_color", "label": "Card", "default": "#f8f7f5" },
    { "type": "color", "id": "accent_color", "label": "Icon", "default": "#6c0013" },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Callout card" }]
}
{% endschema %}
