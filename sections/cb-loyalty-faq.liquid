{%- doc -%}
  Rewards page FAQ, like the loyalty app's: centred heading and line of text, then full-width
  questions between thin black lines, a bold plus (minus when open) on the right.
{%- enddoc -%}

<div
  class="cb-section cb-loyalty cb-loyalty-faq-section"
  style="{% render 'cb-section-style', settings: section.settings %}{% if section.settings.line_color != blank %} --cb-lf-line: {{ section.settings.line_color }};{% endif %}"
>
  <div class="cb-container cb-loyalty__container">
    <div class="cb-loyalty__block">
      <div class="cb-loyalty__wrapper">
        {%- if section.settings.heading != blank -%}
          <h2 class="cb-loyalty__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="cb-loyalty__text">{{ section.settings.text }}</p>
        {%- endif -%}

        <div class="cb-loyalty-faq">
          {%- for block in section.blocks -%}
            <details class="cb-loyalty-faq__entry" {{ block.shopify_attributes }}>
              <summary class="cb-loyalty-faq__question">
                <span>{{ block.settings.question }}</span>
                <svg class="cb-loyalty-faq__plus" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                  <path class="cb-loyalty-faq__vertical" d="M12 5V19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div class="cb-loyalty-faq__answer">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- if section.settings.faq_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Rewards FAQ",
  "tag": "section",
  "class": "cb-section-wrapper",
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is our Rewards Program?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Use this text to answer the question.</p>"
        }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "text", "id": "text", "label": "Text under heading", "default": "Have questions? We have answers!" },
    {
      "type": "checkbox",
      "id": "faq_schema",
      "label": "Add FAQ structured data (SEO)",
      "info": "Turn on for one FAQ section per page only",
      "default": false
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "line_color", "label": "Lines", "default": "#000000" },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 60 }
  ],
  "presets": [
    {
      "name": "Rewards FAQ",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
